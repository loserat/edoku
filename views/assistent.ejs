<!doctype html>
<html lang="de">
<head><%- include('partials/head', { pageTitle: 'Doku-Assistent' }) %><link rel="stylesheet" href="/css/components/assistant.css"></head>
<body class="<%= panel ? 'assistant-panel-body' : '' %>">
<%- include('partials/header', { active }) %>
<main id="main-content" tabindex="-1" class="page wide assistant-page assistant-workspace <%= review ? 'assistant-focused-review' : '' %>">
<% const statuses = { queued:'Vorbereitet',working:'In Vorbereitung',needs_info:'Angaben offen',review:'Zur Prüfung bereit',closed:'Abgeschlossen' }; const base = selected ? '/assistent/auftraege/' + selected.id : '/assistent'; const scope = ''; %>
<%- include('partials/flash', { flash }) %>
<div class="settings-panel assistant-update" data-assistant-updates data-project-id="<%= activeProject.id %>" <%- selected ? 'data-job-id="' + selected.id + '"' : 'data-status-url="/assistent/status"' %> data-updated-at="<%= selected ? viewVersion : dashboardVersion %>" hidden><p data-assistant-update-text></p><a class="secondary" href="<%= base %>?ansicht=<%= section %><%= scope %>">Neuen Stand laden</a></div>
<% if (review) { %>
  <div class="assistant-review-heading"><a href="<%= base %>">← Zur Arbeitsliste</a><span class="field-hint">Jede Datei einzeln prüfen</span></div>
  <div data-review-host><%- include('partials/assistantReview') %></div>
<% } else { %>
  <div data-workspace-content><%- include('partials/assistantWorkspaceSurface') %></div>
  <%- include('partials/assistantWorkspaceDialogs') %>
<% } %>
</main>
<%- include('partials/footer') %><script src="/js/app.js"></script><script src="/js/assistent.js"></script><script src="/js/assistant-workspace.js"></script>
<% if (review) { %><script src="/js/assistant-review.js"></script><script type="module" src="/js/assistant-pdf.mjs"></script><% } %>
</body></html>
