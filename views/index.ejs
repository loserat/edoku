<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>edoku</title>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <%- include("partials/header", { active }) %>
    <main class="page">
      <section class="intro">
        <p class="eyebrow">Elektro-Bestandsunterlagen</p>
        <h1>edoku</h1>
        <p>Lokales Werkzeug zur strukturierten Vorbereitung von Elektro-Dokumentationen. Die erste Version verwaltet Projektdaten, Leistungsbereiche, Anhänge, Dokumentenmatrix und Gerätelisten dateibasiert als JSON.</p>
      </section>

      <section class="quick-grid" aria-label="Navigation">
        <a class="quick-link" href="/projekt">
          <span>Projekt</span>
          <small>Stammdaten pflegen</small>
        </a>
        <a class="quick-link" href="/leistungsbereiche">
          <span>Leistungsbereiche</span>
          <small>Gewerke auswaehlen</small>
        </a>
        <a class="quick-link" href="/dokumente">
          <span>Dokumentenmatrix</span>
          <small>Aktivierung und Export steuern</small>
        </a>
        <a class="quick-link" href="/geraetelisten">
          <span>Gerätelisten</span>
          <small>Listen je Leistungsbereich bearbeiten</small>
        </a>
        <a class="quick-link" href="/brandschutz">
          <span>Brandschutz</span>
          <small>Brandschottungen dokumentieren</small>
        </a>
        <a class="quick-link" href="/export">
          <span>Export</span>
          <small>Ausgabe vorbereiten</small>
        </a>
      </section>
    </main>
    <%- include("partials/footer") %>
    <script src="/js/app.js"></script>
  </body>
</html>
