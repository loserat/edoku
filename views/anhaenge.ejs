<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Anhänge | edoku</title>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <%# Anhangsverwaltung: Upload, Metadaten und Zuordnung laufen immer in der aktuell ausgewählten Kategorie. %>
    <%- include("partials/header", { active }) %>
    <main class="page wide compact-work-page attachments-page">
      <%- include("partials/flash", { flash }) %>
      <%- include("partials/sectionTabs", { active, selectedKategorie }) %>
      <%# Projekt-Stockwerke als Vorschlagsliste für Pläne, Messprotokolle und Brandschutzbilder. %>
      <datalist id="projekt-stockwerke">
        <% (stockwerke || []).forEach((stockwerk) => { %>
          <option value="<%= stockwerk %>"></option>
        <% }) %>
      </datalist>

      <section class="attachment-topline">
        <div class="attachment-title-block">
          <p class="eyebrow">Projektdateien</p>
          <h1><%= selectedKategorie || "Anhänge" %></h1>
          <p class="page-subtitle compact-subtitle">
            <% if (["Stromlaufpläne", "Schaltpläne", "Installationspläne", "Schemata", "Messprotokolle"].includes(selectedKategorie)) { %>
              Diese Dateien werden automatisch im passenden Kapitel einsortiert und nach Projekt-Stockwerk geordnet.
            <% } else if (selectedKategorie === "Bedienungsanleitungen") { %>
              Bedienungsanleitungen werden hier hochgeladen und anschließend in den Gerätelisten mit einzelnen Geräten verknüpft.
            <% } else if (selectedKategorie === "Brandschutz" || selectedKategorie === "Fotos") { %>
              Bilder werden hier verwaltet und einer Brandschottung als Foto 1 oder Foto 2 zugeordnet.
            <% } else { %>
              Projektdateien dieser Kategorie verwalten und für die Dokumentation vorbereiten.
            <% } %>
          </p>
        </div>
        <form class="attachment-header-upload" action="/anhaenge/upload?kategorie=<%= encodeURIComponent(selectedKategorie) %>" method="post" enctype="multipart/form-data" data-attachment-upload-form>
          <input type="hidden" name="category" value="<%= selectedKategorie %>">
          <input type="hidden" name="kapitel" value="<%= categoryDefaults.kapitel || "" %>">
          <label>
            <span>Datei</span>
            <input type="file" name="anhang" accept="image/*,application/pdf" required multiple>
          </label>
          <button class="compact-button" type="button" data-attachment-upload-open>Importieren</button>
          <div class="attachment-modal" data-attachment-modal="upload" hidden>
            <div class="attachment-modal-backdrop"></div>
            <section class="attachment-modal-panel" role="dialog" aria-modal="true" aria-label="Anhang importieren">
              <header class="attachment-modal-head">
                <div>
                  <strong>Datei importieren</strong>
                  <span><%= selectedKategorie %></span>
                </div>
              </header>
              <div class="attachment-modal-grid">
                <label>
                  <span>Titel</span>
                  <input type="text" name="title" placeholder="optional">
                </label>
                <% if (["Stromlaufpläne", "Schaltpläne", "Installationspläne", "Schemata", "Messprotokolle"].includes(selectedKategorie)) { %>
                  <label>
                    <span>Stockwerk</span>
                    <input type="text" list="projekt-stockwerke" name="stockwerk" placeholder="z. B. EG">
                  </label>
                <% } %>
                <% if (["Stromlaufpläne", "Schaltpläne"].includes(selectedKategorie)) { %>
                  <label>
                    <span>Verteiler / Schrank</span>
                    <input type="text" name="verteiler" placeholder="z. B. UV EG">
                  </label>
                <% } %>
                <% if (["Schaltpläne", "Schemata", "Messprotokolle", "Bedienungsanleitungen"].includes(selectedKategorie)) { %>
                  <label>
                    <span>Anlage / System</span>
                    <input type="text" name="anlage" placeholder="z. B. Sicherheitsbeleuchtung">
                  </label>
                <% } %>
                <% if (selectedKategorie === "Installationspläne") { %>
                  <label>
                    <span>Bereich / Raumzone</span>
                    <input type="text" name="bereich" placeholder="z. B. Flur Nord">
                  </label>
                <% } %>
                <% if (selectedKategorie === "Messprotokolle") { %>
                  <label>
                    <span>Messart</span>
                    <input type="text" name="messart" placeholder="z. B. VDE 0100">
                  </label>
                  <label>
                    <span>Norm / Grundlage</span>
                    <input type="text" name="normgrundlage" placeholder="z. B. DIN VDE 0100-600">
                  </label>
                  <label>
                    <span>Datum</span>
                    <input type="text" name="datum" placeholder="TT.MM.JJJJ">
                  </label>
                <% } %>
                <% if (["Stromlaufpläne", "Schaltpläne", "Installationspläne", "Schemata"].includes(selectedKategorie)) { %>
                  <label>
                    <span>Plannummer</span>
                    <input type="text" name="plannummer" placeholder="optional">
                  </label>
                  <label>
                    <span>Revision</span>
                    <input type="text" name="revision" placeholder="optional">
                  </label>
                <% } %>
              </div>
              <footer class="attachment-modal-actions">
                <button class="secondary" type="button" data-attachment-modal-close>Abbrechen</button>
                <button type="submit">Import speichern</button>
              </footer>
            </section>
          </div>
        </form>
      </section>

      <%# Arbeitsbereich der Kategorie: oben Upload, darunter vorhandene Dateien bearbeiten. %>
      <section class="attachment-workspace attachment-workspace-single">
        <section class="attachment-main">
          <%# Dateiliste der aktuellen Kategorie. PDFs erhalten Export-Metadaten, Bilder können Brandschottungen zugeordnet werden. %>
          <section class="panel-card attachment-list-card">
            <div class="panel-head compact attachment-list-head">
              <div>
                <h2>Dateien</h2>
                <p><%= anhaenge.length %> Eintrag<%= anhaenge.length === 1 ? "" : "e" %> in <%= selectedKategorie %>.</p>
              </div>
            </div>
            <div class="attachment-card-list">
              <% if (!anhaenge.length) { %>
                <div class="attachment-empty">Noch keine Anhänge in dieser Kategorie vorhanden.</div>
              <% } %>
              <% anhaenge.forEach((entry) => { %>
                <%
                  const assignedFoto1Id = entry.assignedFoto1 && entry.assignedFoto1[0] ? entry.assignedFoto1[0].id : "";
                  const assignedFoto2Id = entry.assignedFoto2 && entry.assignedFoto2[0] ? entry.assignedFoto2[0].id : "";
                  const assignedBrandschutzId = assignedFoto1Id || assignedFoto2Id;
                  const assignedSlot = assignedFoto1Id ? "foto_vorher" : assignedFoto2Id ? "foto_nachher" : "";
                  const formatSource = String(entry.fileName || entry.originalName || entry.mimeType || "");
                  const fileFormat = (formatSource.includes(".") ? formatSource.split(".").pop() : entry.isPdf ? "PDF" : entry.isImage ? "IMG" : "DATEI").toUpperCase();
                %>
                <article class="attachment-tile">
                  <div class="attachment-tile-button" aria-label="Anhang <%= entry.title || entry.originalName %>">
                    <span class="attachment-format-badge <%= entry.isImage ? "is-image" : entry.isPdf ? "is-pdf" : "" %>"><%= fileFormat %></span>
                    <strong><%= entry.title || entry.originalName %></strong>
                    <small><%= entry.isPdf ? "PDF" : entry.isImage ? "Bild" : entry.mimeType %> · <%= entry.sizeKb %> KB</small>
                    <span class="attachment-tile-meta"><%= entry.documentStatus %></span>
                  </div>
                  <div class="attachment-tile-footer">
                    <div class="attachment-tile-badges">
                    <span class="badge <%= entry.exists ? "on" : "off" %>"><%= entry.exists ? "vorhanden" : "fehlt" %></span>
                    </div>
                    <button class="secondary compact-button" type="button" data-attachment-modal-open="<%= entry.id %>">Bearbeiten</button>
                  </div>

                  <div class="attachment-modal" data-attachment-modal="<%= entry.id %>" hidden>
                    <div class="attachment-modal-backdrop"></div>
                    <section class="attachment-modal-panel" role="dialog" aria-modal="true" aria-label="Anhang bearbeiten">
                      <header class="attachment-modal-head">
                        <div>
                          <strong><%= entry.title || entry.originalName %></strong>
                          <span><%= entry.isPdf ? "PDF" : entry.isImage ? "Bild" : entry.mimeType %> · <%= entry.sizeKb %> KB · <%= entry.uploadedLabel %></span>
                        </div>
                      </header>

                      <% if (entry.isImage) { %>
                        <section class="attachment-preview">
                          <img src="/anhaenge/preview?id=<%= encodeURIComponent(entry.id) %>" alt="Vorschau <%= entry.title || entry.originalName %>">
                        </section>
                      <% } else if (entry.isPdf) { %>
                        <section class="attachment-preview attachment-preview-placeholder">
                          <span class="attachment-file-icon is-pdf"><%- include("partials/icon", { name: "file" }) %></span>
                          <div>
                            <strong>PDF-Datei</strong>
                            <span>Die Vorschau wird über den Button unten geöffnet.</span>
                          </div>
                        </section>
                      <% } %>

                      <form class="attachment-detail-form attachment-modal-grid" action="/anhaenge/<%= encodeURIComponent(entry.id) %>/aktualisieren" method="post">
                        <input type="hidden" name="returnKategorie" value="<%= selectedKategorie || "" %>">
                        <input type="hidden" name="category" value="<%= selectedKategorie %>">
                        <input type="hidden" name="kapitel" value="<%= entry.kapitel || categoryDefaults.kapitel || "" %>">
                        <label>
                          <span>Titel</span>
                          <input type="text" name="title" value="<%= entry.title || entry.originalName %>">
                        </label>
                        <% if (["Stromlaufpläne", "Schaltpläne", "Installationspläne", "Schemata", "Messprotokolle"].includes(selectedKategorie)) { %>
                          <label>
                            <span>Stockwerk</span>
                            <input type="text" list="projekt-stockwerke" name="stockwerk" value="<%= entry.stockwerk || "" %>" placeholder="z. B. EG">
                          </label>
                        <% } %>
                        <% if (["Stromlaufpläne", "Schaltpläne"].includes(selectedKategorie)) { %>
                          <label>
                            <span>Verteiler / Schrank</span>
                            <input type="text" name="verteiler" value="<%= entry.verteiler || "" %>" placeholder="z. B. UV EG">
                          </label>
                        <% } %>
                        <% if (["Schaltpläne", "Schemata", "Messprotokolle", "Bedienungsanleitungen"].includes(selectedKategorie)) { %>
                          <label>
                            <span>Anlage / System</span>
                            <input type="text" name="anlage" value="<%= entry.anlage || "" %>" placeholder="z. B. Sicherheitsbeleuchtung">
                          </label>
                        <% } %>
                        <% if (selectedKategorie === "Installationspläne") { %>
                          <label>
                            <span>Bereich / Raumzone</span>
                            <input type="text" name="bereich" value="<%= entry.bereich || "" %>" placeholder="z. B. Flur Nord">
                          </label>
                        <% } %>
                        <% if (selectedKategorie === "Messprotokolle") { %>
                          <label>
                            <span>Messart</span>
                            <input type="text" name="messart" value="<%= entry.messart || "" %>" placeholder="z. B. VDE 0100">
                          </label>
                          <label>
                            <span>Norm / Grundlage</span>
                            <input type="text" name="normgrundlage" value="<%= entry.normgrundlage || "" %>" placeholder="z. B. DIN VDE 0100-600">
                          </label>
                          <label>
                            <span>Datum</span>
                            <input type="text" name="datum" value="<%= entry.datum || "" %>" placeholder="TT.MM.JJJJ">
                          </label>
                        <% } %>
                        <% if (["Stromlaufpläne", "Schaltpläne", "Installationspläne", "Schemata"].includes(selectedKategorie)) { %>
                          <label>
                            <span>Plannummer</span>
                            <input type="text" name="plannummer" value="<%= entry.plannummer || "" %>" placeholder="optional">
                          </label>
                          <label>
                            <span>Revision</span>
                            <input type="text" name="revision" value="<%= entry.revision || "" %>" placeholder="optional">
                          </label>
                        <% } %>

                        <% if (entry.isImage) { %>
                        <section class="attachment-assign-form attachment-modal-assign">
                          <div class="attachment-assign-head">
                            <strong>Brandschottung zuweisen</strong>
                            <span>Es werden nur freie Foto-Slots angezeigt. Bereits belegte Slots bleiben geschützt.</span>
                          </div>
                          <div class="attachment-brandschutz-grid">
                            <%
                              const visibleBrandschutzSlots = [];
                              (brandschutz || []).forEach((schottung) => {
                                const foto1TakenByOther = Boolean(schottung.foto_vorher && schottung.foto_vorher !== entry.relativePath);
                                const foto2TakenByOther = Boolean(schottung.foto_nachher && schottung.foto_nachher !== entry.relativePath);
                                const availableSlots = [];
                                if (!foto1TakenByOther) availableSlots.push({ key: "foto_vorher", label: "Foto 1" });
                                if (!foto2TakenByOther) availableSlots.push({ key: "foto_nachher", label: "Foto 2" });
                                if (availableSlots.length) visibleBrandschutzSlots.push({ schottung, availableSlots });
                              });
                            %>
                            <% if (!visibleBrandschutzSlots.length) { %>
                              <div class="attachment-empty">Alle Brandschottungen haben bereits zwei Bilder.</div>
                            <% } %>
                            <% visibleBrandschutzSlots.forEach(({ schottung, availableSlots }) => { %>
                              <div class="attachment-brandschutz-card attachment-brandschutz-slot-card">
                                <span>
                                  <strong><%= schottung.geschoss || "-" %> / <%= schottung.raum || "-" %></strong>
                                  <small><%= schottung.bauteil || schottung.abschottungssystem || schottung.id %></small>
                                </span>
                                <div class="attachment-slot-options inline">
                                  <% availableSlots.forEach((slotOption) => { %>
                                    <label>
                                      <input
                                        type="radio"
                                        name="brandschutzSlot"
                                        value="<%= schottung.id %>|<%= slotOption.key %>"
                                        <%= assignedBrandschutzId === schottung.id && assignedSlot === slotOption.key ? "checked" : "" %>
                                      >
                                      <span><%= slotOption.label %></span>
                                    </label>
                                  <% }) %>
                                </div>
                              </div>
                            <% }) %>
                          </div>
                          <% if (entry.assignedCount) { %>
                            <div class="attachment-assignment-list">
                              <% entry.assignedFoto1.forEach((schottung) => { %>
                                <span>Foto 1: <%= schottung.geschoss || "-" %> / <%= schottung.raum || "-" %></span>
                              <% }) %>
                              <% entry.assignedFoto2.forEach((schottung) => { %>
                                <span>Foto 2: <%= schottung.geschoss || "-" %> / <%= schottung.raum || "-" %></span>
                              <% }) %>
                            </div>
                          <% } %>
                        </section>
                        <% } %>

                        <small class="attachment-path"><%= entry.relativePath %></small>

                        <footer class="attachment-modal-actions attachment-bottom-actions">
                          <div class="attachment-bottom-left">
                            <a class="button-link" href="/anhaenge/download?id=<%= encodeURIComponent(entry.id) %>">Download</a>
                            <% if (entry.isPdf) { %>
                              <button class="secondary" type="button" data-pdf-modal-open data-pdf-src="/anhaenge/preview?id=<%= encodeURIComponent(entry.id) %>" data-pdf-title="<%= entry.title || entry.originalName %>">Vorschau</button>
                            <% } else if (entry.isImage) { %>
                              <a class="button-link secondary" href="/anhaenge/preview?id=<%= encodeURIComponent(entry.id) %>" target="_blank" rel="noopener">Vorschau</a>
                            <% } %>
                            <button class="danger-button icon-only-button" type="submit" form="delete-<%= entry.id %>" aria-label="Anhang löschen"><%- include("partials/icon", { name: "trash" }) %></button>
                          </div>
                          <div class="attachment-bottom-right">
                            <button class="secondary" type="button" data-attachment-modal-close>Abbrechen</button>
                            <button class="success-button attachment-save-button" type="submit">Speichern</button>
                          </div>
                        </footer>
                      </form>
                      <form id="delete-<%= entry.id %>" action="/anhaenge/<%= encodeURIComponent(entry.id) %>/loeschen" method="post" data-confirm="Anhang wirklich löschen?" hidden></form>
                    </section>
                  </div>
                </article>
              <% }) %>
            </div>
          </section>
        </section>
      </section>
    </main>
    <%- include("partials/footer") %>
    <script id="attachment-category-defaults-json" type="application/json"><%- JSON.stringify(documentAttachmentCategories.reduce((defaults, entry) => ({ ...defaults, [entry.category]: entry }), {})) %></script>
    <script src="/js/app.js"></script>
  </body>
</html>
