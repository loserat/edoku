<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Anhänge | edoku</title>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <%- include("partials/header", { active }) %>
    <main class="page wide compact-work-page">
      <div class="page-title">
        <p class="eyebrow">Projektdateien</p>
        <h1><%= selectedKategorie || "Anhänge" %></h1>
        <p class="page-subtitle">Projektbezogene PDF-Dateien und Bilder hochladen, kategorisieren und für die Dokumentation bereitstellen.</p>
      </div>
      <%- include("partials/flash", { flash }) %>
      <%- include("partials/sectionTabs", { active, selectedKategorie }) %>
      <datalist id="projekt-stockwerke">
        <% (stockwerke || []).forEach((stockwerk) => { %>
          <option value="<%= stockwerk %>"></option>
        <% }) %>
      </datalist>

      <section class="attachment-layout">
        <form class="panel-card attachment-upload" action="/anhaenge/upload<%= selectedKategorie ? `?kategorie=${encodeURIComponent(selectedKategorie)}` : "" %>" method="post" enctype="multipart/form-data">
          <div class="panel-head compact">
            <div>
              <h2>Anhang hinzufügen</h2>
              <p>PDFs werden später nach Kategorie und Kapitel in Inhaltsverzeichnis und Export eingeordnet.</p>
            </div>
          </div>
          <div class="form-grid">
            <label>
              <span>Datei</span>
              <input type="file" name="anhang" accept="image/*,application/pdf" required>
            </label>
            <label>
              <span>Titel</span>
              <input type="text" name="title" placeholder="Titel für Inhaltsverzeichnis / Export">
            </label>
            <label>
              <span>Kategorie</span>
              <select name="category">
                <% attachmentCategories.forEach((category) => { %>
                  <option value="<%= category %>" <%= (selectedKategorie || "Brandschutz") === category ? "selected" : "" %>><%= category %></option>
                <% }) %>
              </select>
            </label>
            <label>
              <span>Kapitel</span>
              <input type="text" name="kapitel" value="<%= categoryDefaults.kapitel || "" %>" placeholder="z. B. 12.1">
            </label>
            <label>
              <span>Stockwerk (optional)</span>
              <input type="text" list="projekt-stockwerke" name="stockwerk" placeholder="z. B. EG">
            </label>
            <label class="toggle-row compact-toggle">
              <input type="checkbox" name="export" checked>
              <span>In Export aufnehmen</span>
            </label>
          </div>
          <button type="submit">Hochladen</button>
        </form>

        <section class="panel-card">
          <div class="panel-head compact">
            <div>
              <h2>Anhangsliste</h2>
              <p><%= anhaenge.length %> Datei<%= anhaenge.length === 1 ? "" : "en" %><%= selectedKategorie ? ` in ${selectedKategorie}` : " im aktuellen Projekt" %>.</p>
            </div>
            <% if (selectedKategorie) { %>
              <a class="button-link" href="/anhaenge">Alle anzeigen</a>
            <% } %>
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Datei</th>
                  <th>Kategorie</th>
                  <th>Export</th>
                  <th>Kapitel</th>
                  <th>Typ</th>
                  <th>Größe</th>
                  <th>Hochgeladen</th>
                  <th>Aktionen</th>
                </tr>
              </thead>
              <tbody>
                <% if (!anhaenge.length) { %>
                  <tr>
                    <td colspan="8">Noch keine Anhänge vorhanden.</td>
                  </tr>
                <% } %>
                <% anhaenge.forEach((entry) => { %>
                  <% const isImage = entry.mimeType && entry.mimeType.indexOf("image/") === 0; %>
                  <% const usedAsFoto1 = (brandschutz || []).filter((schottung) => schottung.foto_vorher === entry.relativePath); %>
                  <% const usedAsFoto2 = (brandschutz || []).filter((schottung) => schottung.foto_nachher === entry.relativePath); %>
                  <tr>
                    <td>
                      <strong><%= entry.originalName %></strong>
                      <small class="meta-line"><%= entry.relativePath %></small>
                      <% if (entry.mimeType === "application/pdf") { %>
                        <form class="attachment-meta-form" action="/anhaenge/<%= encodeURIComponent(entry.id) %>/aktualisieren" method="post" data-autosave>
                          <input type="hidden" name="returnKategorie" value="<%= selectedKategorie || "" %>">
                          <label>
                            <span>Titel</span>
                            <input type="text" name="title" value="<%= entry.title || entry.originalName %>">
                          </label>
                          <label>
                            <span>Kategorie</span>
                            <select name="category">
                              <% attachmentCategories.forEach((category) => { %>
                                <option value="<%= category %>" <%= entry.category === category ? "selected" : "" %>><%= category %></option>
                              <% }) %>
                            </select>
                          </label>
                          <label>
                            <span>Kapitel</span>
                            <input type="text" name="kapitel" value="<%= entry.kapitel || "" %>" placeholder="z. B. 12.1">
                          </label>
                          <label>
                            <span>Stockwerk</span>
                            <input type="text" list="projekt-stockwerke" name="stockwerk" value="<%= entry.stockwerk || "" %>" placeholder="optional">
                          </label>
                          <label class="toggle-row compact-toggle">
                            <input type="checkbox" name="export" <%= entry.export !== false ? "checked" : "" %>>
                            <span>Export</span>
                          </label>
                        </form>
                      <% } %>
                      <% if (usedAsFoto1.length || usedAsFoto2.length) { %>
                        <small class="meta-line">
                          Zugeordnet:
                          <% usedAsFoto1.forEach((schottung) => { %>
                            Foto 1 bei <%= schottung.id %> <%= schottung.raum ? `(${schottung.raum})` : "" %>
                          <% }) %>
                          <% usedAsFoto2.forEach((schottung) => { %>
                            Foto 2 bei <%= schottung.id %> <%= schottung.raum ? `(${schottung.raum})` : "" %>
                          <% }) %>
                        </small>
                      <% } %>
                    </td>
                    <td><span class="badge on"><%= entry.category %></span></td>
                    <td><%= entry.export !== false ? "Ja" : "Nein" %></td>
                    <td><%= entry.kapitel || "-" %></td>
                    <td><%= entry.mimeType %></td>
                    <td><%= Math.max(1, Math.round(entry.size / 1024)) %> KB</td>
                    <td><%= entry.uploadedAt ? new Date(entry.uploadedAt).toLocaleString("de-DE") : "-" %></td>
                    <td>
                      <div class="table-actions">
                        <a class="button-link" href="/anhaenge/download?id=<%= encodeURIComponent(entry.id) %>">Download</a>
                        <form action="/anhaenge/<%= encodeURIComponent(entry.id) %>/loeschen" method="post">
                          <button class="danger-button" type="submit">Löschen</button>
                        </form>
                      </div>
                      <% if (isImage) { %>
                        <form class="attachment-assign-form" action="/anhaenge/<%= encodeURIComponent(entry.id) %>/zuordnen" method="post">
                          <select name="brandschutzId" required>
                            <option value="">Brandschottung wählen</option>
                            <% (brandschutz || []).forEach((schottung) => { %>
                              <option value="<%= schottung.id %>"><%= schottung.id %> | <%= schottung.geschoss || "-" %> / <%= schottung.raum || "-" %></option>
                            <% }) %>
                          </select>
                          <select name="slot" required>
                            <option value="foto_vorher">Foto 1</option>
                            <option value="foto_nachher">Foto 2</option>
                          </select>
                          <button type="submit">Zuordnen</button>
                        </form>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
      </section>
    </main>
    <%- include("partials/footer") %>
    <script src="/js/app.js"></script>
  </body>
</html>
