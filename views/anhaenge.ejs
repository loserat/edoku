<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Anhänge | edoku</title>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <%- include("partials/header", { active }) %>
    <main class="page wide compact-work-page attachments-page">
      <%- include("partials/flash", { flash }) %>
      <%- include("partials/sectionTabs", { active, selectedKategorie }) %>
      <datalist id="projekt-stockwerke">
        <% (stockwerke || []).forEach((stockwerk) => { %>
          <option value="<%= stockwerk %>"></option>
        <% }) %>
      </datalist>

      <section class="attachment-topline">
        <div>
          <p class="eyebrow">Projektdateien</p>
          <h1><%= selectedKategorie || "Anhänge" %></h1>
        </div>
      </section>

      <section class="attachment-workspace attachment-workspace-single">
        <section class="attachment-main">
          <form class="panel-card attachment-upload" action="/anhaenge/upload?kategorie=<%= encodeURIComponent(selectedKategorie) %>" method="post" enctype="multipart/form-data">
            <div class="panel-head compact">
              <div>
                <h2>Datei in <%= selectedKategorie %> hinzufügen</h2>
                <p>
                  <% if (["Stromlaufpläne", "Schaltpläne", "Installationspläne", "Schemata", "Messprotokolle"].includes(selectedKategorie)) { %>
                    PDF hochladen und anschließend Kapitel sowie Stockwerk für Inhaltsverzeichnis und Export pflegen.
                  <% } else if (selectedKategorie === "Brandschutz" || selectedKategorie === "Fotos") { %>
                    Bilder hochladen und anschließend einer Brandschottung als Foto 1 oder Foto 2 zuordnen.
                  <% } else { %>
                    Datei hochladen und anschließend die Einordnung im aktuellen Bereich pflegen.
                  <% } %>
                </p>
              </div>
            </div>
            <div class="attachment-upload-grid">
              <label>
                <span>Datei</span>
                <input type="file" name="anhang" accept="image/*,application/pdf" required>
              </label>
              <label>
                <span>Titel</span>
                <input type="text" name="title" placeholder="Titel für Inhaltsverzeichnis / Export">
              </label>
              <input type="hidden" name="category" value="<%= selectedKategorie %>">
              <label>
                <span>Kapitel</span>
                <input type="text" name="kapitel" value="<%= categoryDefaults.kapitel || "" %>" placeholder="z. B. 12.1">
              </label>
              <label>
                <span>Stockwerk</span>
                <input type="text" list="projekt-stockwerke" name="stockwerk" placeholder="optional">
              </label>
              <label class="toggle-row compact-toggle">
                <input type="checkbox" name="export" checked>
                <span>Export</span>
              </label>
              <button type="submit">Hochladen</button>
            </div>
          </form>

          <section class="panel-card attachment-list-card">
            <div class="panel-head compact attachment-list-head">
              <div>
                <h2>Dateien</h2>
                <p><%= anhaenge.length %> Eintrag<%= anhaenge.length === 1 ? "" : "e" %> in <%= selectedKategorie %>.</p>
              </div>
            </div>
            <div class="attachment-card-list">
              <% if (!anhaenge.length) { %>
                <div class="attachment-empty">Noch keine Anhänge in dieser Kategorie vorhanden.</div>
              <% } %>
              <% anhaenge.forEach((entry) => { %>
                <article class="attachment-item">
                  <div class="attachment-item-head">
                    <div>
                      <h3><%= entry.title || entry.originalName %></h3>
                      <p><%= entry.originalName %> · <%= entry.sizeKb %> KB · <%= entry.uploadedLabel %></p>
                    </div>
                    <div class="attachment-status-stack horizontal">
                      <span class="badge <%= entry.exists ? "on" : "off" %>"><%= entry.exists ? "vorhanden" : "fehlt" %></span>
                      <span class="badge <%= entry.export !== false ? "on" : "off" %>"><%= entry.export !== false ? "Export" : "kein Export" %></span>
                      <span class="badge"><%= entry.isPdf ? "PDF" : entry.isImage ? "Bild" : entry.mimeType %></span>
                    </div>
                  </div>

                  <% if (entry.isPdf) { %>
                    <form class="attachment-detail-form" action="/anhaenge/<%= encodeURIComponent(entry.id) %>/aktualisieren" method="post" data-autosave>
                      <input type="hidden" name="returnKategorie" value="<%= selectedKategorie || "" %>">
                      <input type="hidden" name="category" value="<%= selectedKategorie %>">
                      <label>
                        <span>Titel</span>
                        <input type="text" name="title" value="<%= entry.title || entry.originalName %>">
                      </label>
                      <label>
                        <span>Kapitel</span>
                        <input type="text" name="kapitel" value="<%= entry.kapitel || "" %>" placeholder="<%= categoryDefaults.kapitel || "" %>">
                      </label>
                      <% if (["Stromlaufpläne", "Installationspläne"].includes(selectedKategorie)) { %>
                        <label>
                          <span>Stockwerk</span>
                          <input type="text" list="projekt-stockwerke" name="stockwerk" value="<%= entry.stockwerk || "" %>" placeholder="z. B. EG">
                        </label>
                      <% } %>
                      <% if (["Stromlaufpläne", "Schaltpläne"].includes(selectedKategorie)) { %>
                        <label>
                          <span>Verteiler / Schrank</span>
                          <input type="text" name="verteiler" value="<%= entry.verteiler || "" %>" placeholder="z. B. UV EG">
                        </label>
                      <% } %>
                      <% if (["Schaltpläne", "Schemata", "Messprotokolle"].includes(selectedKategorie)) { %>
                        <label>
                          <span>Anlage / System</span>
                          <input type="text" name="anlage" value="<%= entry.anlage || "" %>" placeholder="z. B. Sicherheitsbeleuchtung">
                        </label>
                      <% } %>
                      <% if (selectedKategorie === "Installationspläne") { %>
                        <label>
                          <span>Bereich / Raumzone</span>
                          <input type="text" name="bereich" value="<%= entry.bereich || "" %>" placeholder="z. B. Flur Nord">
                        </label>
                      <% } %>
                      <% if (selectedKategorie === "Messprotokolle") { %>
                        <label>
                          <span>Messart</span>
                          <input type="text" name="messart" value="<%= entry.messart || "" %>" placeholder="z. B. VDE 0100">
                        </label>
                        <label>
                          <span>Norm / Grundlage</span>
                          <input type="text" name="normgrundlage" value="<%= entry.normgrundlage || "" %>" placeholder="z. B. DIN VDE 0100-600">
                        </label>
                        <label>
                          <span>Datum</span>
                          <input type="text" name="datum" value="<%= entry.datum || "" %>" placeholder="TT.MM.JJJJ">
                        </label>
                      <% } %>
                      <% if (["Stromlaufpläne", "Schaltpläne", "Installationspläne", "Schemata"].includes(selectedKategorie)) { %>
                        <label>
                          <span>Plannummer</span>
                          <input type="text" name="plannummer" value="<%= entry.plannummer || "" %>" placeholder="optional">
                        </label>
                        <label>
                          <span>Revision</span>
                          <input type="text" name="revision" value="<%= entry.revision || "" %>" placeholder="optional">
                        </label>
                      <% } %>
                      <label class="toggle-row compact-toggle">
                        <input type="checkbox" name="export" <%= entry.export !== false ? "checked" : "" %>>
                        <span>Export</span>
                      </label>
                    </form>
                    <small class="attachment-target"><%= entry.documentStatus %></small>
                  <% } %>

                  <% if (entry.isImage) { %>
                    <form class="attachment-assign-form" action="/anhaenge/<%= encodeURIComponent(entry.id) %>/zuordnen" method="post">
                      <select name="brandschutzId" required>
                        <option value="">Brandschottung wählen</option>
                        <% (brandschutz || []).forEach((schottung) => { %>
                          <option value="<%= schottung.id %>"><%= schottung.id %> | <%= schottung.geschoss || "-" %> / <%= schottung.raum || "-" %></option>
                        <% }) %>
                      </select>
                      <select name="slot" required>
                        <option value="foto_vorher">Foto 1</option>
                        <option value="foto_nachher">Foto 2</option>
                      </select>
                      <button type="submit">Zuordnen</button>
                    </form>
                    <% if (entry.assignedCount) { %>
                      <div class="attachment-assignment-list">
                        <% entry.assignedFoto1.forEach((schottung) => { %>
                          <span>Foto 1: <%= schottung.geschoss || "-" %> / <%= schottung.raum || "-" %></span>
                        <% }) %>
                        <% entry.assignedFoto2.forEach((schottung) => { %>
                          <span>Foto 2: <%= schottung.geschoss || "-" %> / <%= schottung.raum || "-" %></span>
                        <% }) %>
                      </div>
                    <% } %>
                  <% } %>

                  <div class="attachment-item-actions">
                    <small><%= entry.relativePath %></small>
                    <div class="table-actions">
                      <a class="button-link" href="/anhaenge/download?id=<%= encodeURIComponent(entry.id) %>">Laden</a>
                      <form action="/anhaenge/<%= encodeURIComponent(entry.id) %>/loeschen" method="post">
                        <button class="danger-button" type="submit">Löschen</button>
                      </form>
                    </div>
                  </div>
                </article>
              <% }) %>
            </div>
          </section>
        </section>
      </section>
    </main>
    <%- include("partials/footer") %>
    <script id="attachment-category-defaults-json" type="application/json"><%- JSON.stringify(documentAttachmentCategories.reduce((defaults, entry) => ({ ...defaults, [entry.category]: entry }), {})) %></script>
    <script src="/js/app.js"></script>
  </body>
</html>
