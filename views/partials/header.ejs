<%# Gemeinsamer Header für alle angemeldeten Seiten: Branding, Projektstatus, Hauptnavigation, Benutzer und Theme-Schalter. %>
<%- include("themeVariables") %>
<header class="site-header">
  <div class="brand-block">
    <a class="brand" href="/">
      <img class="brand-logo" src="/img/logo.svg" alt="" width="32" height="32">
      <span class="brand-name"><%= typeof currentProjectName !== "undefined" && currentProjectName ? currentProjectName : "edoku" %></span>
    </a>
  </div>
  <nav class="nav" aria-label="Hauptnavigation">
    <% const dashboardLabel = typeof currentProjectNumber !== "undefined" && currentProjectNumber ? currentProjectNumber : typeof currentProjectName !== "undefined" && currentProjectName ? currentProjectName : "Übersicht"; %>
    <a class="<%= ["projekte", "projekt", "leistungsbereiche", "projektarchiv"].includes(active) ? "active" : "" %>" href="/projekte"><%- include("icon", { name: "project" }) %><span>Projekte</span></a>
    <a class="<%= active === "dashboard" ? "active" : "" %>" href="/dashboard" title="Projektübersicht"><%- include("icon", { name: "overview" }) %><span><%= dashboardLabel %></span></a>
    <a class="<%= ["dokumente", "anhaenge"].includes(active) ? "active" : "" %>" href="/anhaenge?kategorie=Brandschutz"><%- include("icon", { name: "documentation" }) %><span>Anhänge</span></a>
    <% if (typeof showBrandschutzNavigation !== "undefined" && showBrandschutzNavigation) { %>
      <a class="<%= active === "brandschutz" ? "active" : "" %>" href="/brandschutz"><%- include("icon", { name: "shield" }) %><span>Brandschutz</span></a>
    <% } %>
    <a class="<%= active === "geraetelisten" ? "active" : "" %>" href="/geraetelisten"><%- include("icon", { name: "list" }) %><span>Gerätelisten</span></a>
    <a class="<%= active === "export" ? "active" : "" %>" href="/export"><%- include("icon", { name: "export" }) %><span>Export</span></a>
  </nav>
  <div class="header-actions">
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Theme wechseln">
      <span class="theme-toggle-icon theme-toggle-sun"><%- include("icon", { name: "sun" }) %></span>
      <span class="theme-toggle-icon theme-toggle-moon"><%- include("icon", { name: "moon" }) %></span>
    </button>
    <% if (typeof user !== "undefined" && user) { %>
      <%# Benutzeraktionen bleiben im Header kompakt und werden erst bei Hover/Fokus angezeigt. %>
      <div class="user-menu header-user-menu">
        <button class="header-icon-button" type="button" aria-label="Benutzermenü" title="Benutzer">
          <%- include("icon", { name: "user" }) %>
        </button>
        <div class="user-dropdown" role="menu">
          <div class="user-dropdown-head">
            <span>Angemeldet</span>
            <strong><%= user.name %></strong>
          </div>
          <% if (user.role === "systemadmin") { %>
            <a href="/einstellungen#benutzer" role="menuitem">Benutzerverwaltung</a>
          <% } %>
          <form action="/logout" method="post">
            <button type="submit" role="menuitem">Abmelden</button>
          </form>
        </div>
      </div>
    <% } %>
    <a class="header-icon-link <%= active === "einstellungen" ? "active" : "" %>" href="/einstellungen" aria-label="System" title="System">
      <%- include("icon", { name: "system" }) %>
    </a>
  </div>
</header>
