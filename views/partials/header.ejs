<%# Gemeinsamer Header für alle angemeldeten Seiten: Branding, Projektstatus, Hauptnavigation, Benutzer und Theme-Schalter. %>
<%- include("themeVariables") %>
<a class="skip-link" href="#main-content">Zum Inhalt springen</a>
<header class="site-header">
  <div class="brand-block">
    <a class="brand" href="/">
      <img class="brand-logo" src="/img/icons/edoku-app-icon.svg?v=2" alt="" width="32" height="32">
      <span class="brand-copy"><span class="brand-name">edoku</span><span class="brand-project" title="<%= typeof currentProjectName !== "undefined" ? currentProjectName : "" %>"><%= typeof currentProjectName !== "undefined" && currentProjectName ? currentProjectName : "Elektrodokumentation" %></span></span>
    </a>
  </div>
  <nav class="nav" aria-label="Hauptnavigation">
    <%
      const navigation = [
        { href: "/projekte", label: "Projekte", icon: "project", sections: ["projekte", "projekt", "leistungsbereiche", "projektarchiv"] },
        { href: "/dashboard", label: "Übersicht", icon: "overview", sections: ["dashboard"] },
        { href: "/anhaenge?kategorie=Brandschutz", label: "Anhänge", icon: "paperclip", sections: ["dokumente", "anhaenge"] },
        { href: "/brandschutz", label: "Brandschutz", icon: "shield", sections: ["brandschutz"], hidden: !(typeof showBrandschutzNavigation !== "undefined" && showBrandschutzNavigation) },
        { href: "/geraetelisten", label: "Gerätelisten", icon: "list", sections: ["geraetelisten"] },
        { href: "/export", label: "Export", icon: "export", sections: ["export"] }
      ];
    %>
    <% navigation.filter((item) => !item.hidden).forEach((item) => { const selected = item.sections.includes(active); %>
      <a class="<%= selected ? "active" : "" %>" href="<%= item.href %>" title="<%= item.label %>" <%- selected ? 'aria-current="page"' : '' %>><%- include("icon", { name: item.icon }) %><span><%= item.label %></span></a>
    <% }) %>
  </nav>
  <div class="header-actions">
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Theme wechseln">
      <span class="theme-toggle-icon theme-toggle-sun"><%- include("icon", { name: "sun" }) %></span>
      <span class="theme-toggle-icon theme-toggle-moon"><%- include("icon", { name: "moon" }) %></span>
    </button>
    <% if (typeof user !== "undefined" && user) { %>
      <%# Benutzeraktionen bleiben im Header kompakt und werden erst bei Hover/Fokus angezeigt. %>
      <div class="user-menu header-user-menu">
        <button class="header-icon-button" type="button" aria-label="Benutzermenü" title="Benutzer">
          <%- include("icon", { name: "user" }) %>
        </button>
        <div class="user-dropdown" role="menu">
          <div class="user-dropdown-head">
            <span>Angemeldet</span>
            <strong><%= user.name %></strong>
          </div>
          <% if (user.role === "systemadmin") { %>
            <a href="/einstellungen#benutzer" role="menuitem">Benutzerverwaltung</a>
          <% } %>
          <form action="/logout" method="post">
            <button type="submit" role="menuitem">Abmelden</button>
          </form>
        </div>
      </div>
    <% } %>
    <a class="header-icon-link header-settings-link <%= active === "einstellungen" ? "active" : "" %>" href="/einstellungen" aria-label="Einstellungen" title="Einstellungen">
      <%- include("icon", { name: "system" }) %>
    </a>
  </div>
</header>
