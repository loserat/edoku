<header class="site-header">
  <div class="brand-block">
    <a class="brand" href="/">
      <img class="brand-logo" src="/img/logo.svg" alt="" width="32" height="32">
      <span>edoku</span>
    </a>
    <% if (typeof currentProjectId !== "undefined" && currentProjectId) { %>
      <span class="brand-project">Geöffnetes Projekt: <%= typeof currentProjectName !== "undefined" && currentProjectName ? currentProjectName : currentProjectId %></span>
    <% } %>
  </div>
  <nav class="nav" aria-label="Hauptnavigation">
    <a class="<%= active === "dashboard" ? "active" : "" %>" href="/dashboard"><%- include("icon", { name: "overview" }) %><span>Übersicht</span></a>
    <a class="<%= ["projekte", "projekt", "leistungsbereiche", "systemauswahl", "projektarchiv"].includes(active) ? "active" : "" %>" href="/projekte"><%- include("icon", { name: "project" }) %><span>Projekte</span></a>
    <a class="<%= ["dokumente", "anhaenge"].includes(active) ? "active" : "" %>" href="/dokumente"><%- include("icon", { name: "documentation" }) %><span>Dokumentation</span></a>
    <a class="<%= active === "brandschutz" ? "active" : "" %>" href="/brandschutz"><%- include("icon", { name: "shield" }) %><span>Brandschutz</span></a>
    <a class="<%= active === "geraetelisten" ? "active" : "" %>" href="/geraetelisten"><%- include("icon", { name: "list" }) %><span>Gerätelisten</span></a>
    <a class="<%= active === "export" ? "active" : "" %>" href="/export"><%- include("icon", { name: "export" }) %><span>Export</span></a>
    <a class="<%= active === "einstellungen" ? "active" : "" %>" href="/einstellungen"><%- include("icon", { name: "system" }) %><span>System</span></a>
  </nav>
  <% if (typeof user !== "undefined" && user) { %>
    <div class="user-menu">
      <span><%= user.name %></span>
      <form action="/logout" method="post">
        <button class="secondary" type="submit">Abmelden</button>
      </form>
    </div>
  <% } %>
  <button class="theme-toggle" type="button" data-theme-toggle>Tag/Nacht</button>
</header>
