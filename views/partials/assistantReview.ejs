
        <section id="datei-pruefen" class="assistant-review settings-panel" data-review-project="<%= activeProject.id %>" data-review-job="<%= selected.id %>" data-review-id="<%= review.id %>">
          <div class="panel-head"><div><p class="eyebrow">Einzelprüfung</p><h2><%= review.title %></h2><p><%= review.category %></p></div><span class="badge <%= review.state === 'approved' ? 'on' : review.state === 'pending' ? 'off' : '' %>"><%= review.projectDocument && review.projectDocument.scope !== 'documentation' && review.state === 'approved' ? 'Intern freigegeben' : { pending: 'Zu prüfen', approved: 'Übernommen', rejected: 'Abgelehnt', superseded: 'Durch neuere Fassung ersetzt', withdrawn: 'Zurückgezogen' }[review.state] %></span></div>
          <% if (review.projectDocument) { %><p class="field-hint"><%= review.projectDocument.scope === 'documentation' ? 'Nach Freigabe im zugeordneten Kapitel der Kundendokumentation.' : 'Nur intern · kein Kundenexport.' %></p><% } %>
          <% if (review.fireProtectionDocument) { %><p class="field-hint" role="note"><%= review.fireProtectionDocument.stage === 'prepared' ? 'Vorbereitete Brandschutzbestätigung · fachlich prüfen.' : 'Brandschutz-Vorlage / unvollständiger Entwurf · erfüllt keine Pflichtbestätigung.' %> Manuelle Einzelfreigabe erforderlich.</p><% } %>
          <% if (review.productVerification) { %><p class="field-hint">Produktprüfung: <%= review.productVerification.state === 'matched' ? 'Herstellerquelle und Artikelzuordnung bestätigt' : 'Noch unklar' %>. Deine Sichtung und Einzelfreigabe bleiben erforderlich.</p><details><summary>Geprüfte Artikel und Varianten</summary><% (review.productVerification.targets || []).forEach(item => { %><p><%= item.manufacturer %> · <%= item.model %><%= item.documentModel ? ' (PDF: ' + item.documentModel + ')' : '' %> · <%= item.variant || 'keine zusätzliche Variante angegeben' %> · <%= item.via === 'manufacturer_product_manual_link' ? 'produktspezifischer Herstellerlink' : 'Artikelbeleg im PDF' %><% if (item.manufacturerEvidence === 'manufacturer_product_gtin') { %> · Herstellerbeleg über Produktseite und GTIN <%= item.gtin %><% } %></p><% }) %></details><% } %>
          <% if (review.supersededBy) { %><p>Historische Fassung. <a href="/assistent/auftraege/<%= selected.id %>/dateien/<%= review.supersededBy %>">Aktuellen Vorschlag öffnen</a></p><% } %>
          <p data-review-feedback role="status" aria-live="polite" hidden></p>
          <div class="assistant-review-grid">
            <div class="assistant-preview">
              <% if (review.mimeType === 'application/pdf') { %>
                <div class="assistant-pdf" data-pdf-preview data-pdf-url="/assistent/auftraege/<%= selected.id %>/dateien/<%= review.id %>/inhalt">
                  <div class="assistant-actions"><button type="button" class="secondary compact-button" data-pdf-previous aria-label="Vorherige PDF-Seite" disabled>←</button><span data-pdf-page>Wird geladen …</span><button type="button" class="secondary compact-button" data-pdf-next aria-label="Nächste PDF-Seite" disabled>→</button><button type="button" class="secondary compact-button" data-pdf-fit>Ganze Seite</button></div>
                  <p data-pdf-status role="status" aria-live="polite">PDF-Vorschau wird vorbereitet.</p><div class="assistant-pdf-canvas"><canvas aria-label="Dateivorschau"></canvas></div>
                </div>
              <% } else { %><img class="assistant-image-preview" src="/assistent/auftraege/<%= selected.id %>/dateien/<%= review.id %>/inhalt" alt="Dateivorschau: <%= review.title %>"><% } %>
              <a href="/assistent/auftraege/<%= selected.id %>/dateien/<%= review.id %>/inhalt" target="_blank" rel="noopener">Datei separat öffnen</a>
            </div>
            <div class="stack-form">
              <details class="assistant-source-details"><summary>Quelle &amp; Details</summary>
              <div><h3>Quelle</h3><p><%= review.sourceLabel %></p><% if (review.sourceUrl) { %><a href="<%= review.sourceUrl %>" target="_blank" rel="noopener noreferrer">Originalquelle öffnen</a><% } %><p>Dokumentrevision: <%= review.documentRevision || 'Nicht angegeben' %></p><details><summary>Dokumentanforderungen</summary><% selected.requirements.filter(requirement => review.requirementIds?.includes(requirement.id)).forEach(requirement => { %><p><strong>Benötigt für:</strong> <%= requirement.title %><% (requirement.devices || (requirement.device ? [requirement.device] : [])).forEach(device => { %> · <%= device.manufacturer %> · <%= device.model %> · Position <%= device.position %><% }) %></p><% }) %></details><details><summary>Warum diese Datei?</summary><p class="assistant-preserve"><%= review.reason %></p></details></div>
              <details><summary>Datei-Prüfsumme anzeigen</summary><code class="assistant-digest"><%= review.sha256 %></code><p class="field-hint">Diese Prüfsumme bindet die Freigabe an genau diese vorbereitete Datei.</p></details>
              </details>
              <% if (review.state === 'pending') { %>
                <form action="/assistent/auftraege/<%= selected.id %>/dateien/<%= review.id %>/uebernehmen" method="post" class="stack-form" data-document-approval>
                  <%- include('formSecurity') %><input type="hidden" name="sha256" value="<%= review.sha256 %>"><input type="hidden" name="revision" value="<%= revision %>">
                  <label><span>Titel</span><input type="text" name="title" value="<%= review.title %>" maxlength="200" required></label>
                  <label><span>Kategorie</span><select name="category" required><% categories.forEach(category => { %><option value="<%= category %>"<%= category === review.category ? ' selected' : '' %>><%= category %></option><% }) %></select></label>
                  <input type="hidden" name="continueReview" value="1"><input type="hidden" name="panel" value="<%= panel ? '1' : '0' %>"><details class="assistant-assignment"><summary>Zuordnung ändern · <%= review.category %><%= reviewReferences.length ? " · " + reviewReferences.length + " Geräte" : "" %></summary>
                  <div class="form-grid"><label><span>Stockwerk</span><input type="text" name="stockwerk" value="<%= review.stockwerk %>" maxlength="100"></label><label><span>Anlage / System</span><input type="text" name="anlage" value="<%= review.anlage %>" maxlength="200"></label></div>
                  <input type="hidden" name="deviceReferencesPresent" value="1">
                  <fieldset class="assistant-device-targets"><legend>Zuordnung zu Geräten</legend>
                    <p class="field-hint">Für Datenblätter und Bedienungsanleitungen: Die ausgewählten Geräte werden bei der Übernahme mit dieser PDF verknüpft. Ohne Auswahl bleibt sie projektbezogen.</p>
                    <% deviceOptions.forEach(option => { const checked = reviewReferences.some(reference => referenceKey(reference) === referenceKey(option.reference) && reference.manufacturer.trim().toLocaleLowerCase('de') === option.reference.manufacturer.toLocaleLowerCase('de') && reference.model.trim().toLocaleLowerCase('de') === option.reference.model.toLocaleLowerCase('de')); %>
                      <label class="integration-choice"><input type="checkbox" name="deviceReferences" value="<%= JSON.stringify(option.reference) %>"<%= checked ? ' checked' : '' %>><span><%= option.label %></span></label>
                    <% }) %>
                    <% if (!deviceOptions.length) { %><p>Noch keine passenden Geräte mit Hersteller und Typ erfasst. Zuerst die Gerätelisten ergänzen.</p><% } %>
                    <% reviewReferences.filter(reference => !deviceOptions.some(option => referenceKey(reference) === referenceKey(option.reference) && reference.manufacturer.trim().toLocaleLowerCase('de') === option.reference.manufacturer.toLocaleLowerCase('de') && reference.model.trim().toLocaleLowerCase('de') === option.reference.model.toLocaleLowerCase('de'))).forEach(reference => { %><p role="alert">Die vorgeschlagene Zuordnung zu <%= reference.manufacturer %> · <%= reference.model %> · Pos. <%= reference.position %> ist nicht mehr aktuell. Bitte das richtige Gerät auswählen.</p><% }) %>
                  </fieldset></details>
                  <label class="integration-choice assistant-review-confirm"><input type="checkbox" name="reviewed" required><span>Datei gesichtet. Quelle und Zuordnung geprüft.</span></label>
                  <button type="submit" class="success-button assistant-review-submit" disabled><%= nextReview ? 'Freigeben & weiter' : 'Freigeben' %></button>
                  <% if (!revision) { %><p>Für die Übernahme muss der SQLite-Projektspeicher aktiviert sein.</p><% } %>
                </form>
                <details><summary>Datei ablehnen</summary><form action="/assistent/auftraege/<%= selected.id %>/dateien/<%= review.id %>/ablehnen" method="post" data-document-rejection><%- include('formSecurity') %><input type="hidden" name="panel" value="<%= panel ? '1' : '0' %>"><label><span>Ablehnungsgrund</span><textarea name="reason" rows="2" minlength="3" maxlength="1000" required></textarea></label><button type="submit" class="secondary danger">Ablehnen</button></form></details>
                <details><summary>Vorschlag zurückziehen</summary><form action="/assistent/auftraege/<%= selected.id %>/dateien/<%= review.id %>/zurueckziehen" method="post" data-document-withdrawal><%- include('formSecurity') %><input type="hidden" name="panel" value="<%= panel ? '1' : '0' %>"><input type="hidden" name="jobVersion" value="<%= selected.version %>"><label><span>Begründung</span><textarea name="reason" rows="2" minlength="3" maxlength="1000" required></textarea></label><p class="field-hint">Nicht mehr benötigt? Original und Begründung bleiben im Verlauf.</p><button type="submit" class="secondary">Zurückziehen<%= nextReview ? ' & weiter' : '' %></button></form></details>
              <% } else { %><p><%= review.state === 'withdrawn' ? 'Dieser Vorschlag wurde zurückgezogen.' : 'Über diesen Vorschlag wurde bereits entschieden.' %></p><% if (review.withdrawal) { %><p>Begründung: <%= review.withdrawal.reason %></p><p class="field-hint"><%= review.withdrawal.recordedBy %> · <%= new Date(review.withdrawal.recordedAt).toLocaleString('de-DE', {timeZone:'Europe/Berlin'}) %></p><details><summary>Beleg</summary><p><%= review.withdrawal.evidence.sourceLabel %></p><p class="assistant-preserve"><%= review.withdrawal.evidence.sourceQuote %></p></details><% } %><% if (review.rejectionReason) { %><p>Ablehnungsgrund: <%= review.rejectionReason %></p><% } %><% if (nextReview) { %><a href="/assistent/auftraege/<%= selected.id %>/dateien/<%= nextReview.id %><%= panel ? '?panel=1' : '' %>">Nächste Datei öffnen</a><% } else if (pending.length) { %><a href="/assistent/auftraege/<%= selected.id %>?ansicht=dateien&amp;filter=pending">Noch offene Dateien anzeigen</a><% } %><% } %>
            </div>
          </div>
        </section>
