<%# * INFO: Zentrale Sidebar-/Bereichsnavigation. Die Tabs hängen vom aktiven Hauptmenü ab. %>
<% const projectTabs = ["projekte", "projekt", "leistungsbereiche", "projektarchiv"]; %>
<% const documentationTabs = ["dokumente", "anhaenge"]; %>
<% const outputTabs = ["export"]; %>
<% const systemTabs = ["einstellungen"]; %>
<% let tabs = []; %>
<% const selectedCategoryValue = typeof selectedKategorie !== "undefined" ? selectedKategorie : ""; %>
<% const hasDeviceListTabs = active === "geraetelisten" && typeof deviceListTabs !== "undefined" && Array.isArray(deviceListTabs); %>
<% if (hasDeviceListTabs) { %>
  <%# Sonderfall Gerätelisten: jede aktive Geräteliste wird direkt als linker Haupttab angezeigt. %>
  <nav class="section-tabs device-main-tabs" data-device-main-tabs aria-label="Gerätelisten">
    <div class="section-tabs-head">
      <span>Gerätelisten</span>
      <strong>Auswahl</strong>
    </div>
    <button class="device-main-tab" type="button" data-device-main-target="dashboard"><%- include("icon", { name: "overview" }) %><span>Dashboard</span></button>
    <% deviceListTabs.forEach((liste) => { %>
      <% const tabLabel = String(liste.titel || "").replace(/^Geräteliste\s+/i, ""); %>
      <% const shortLabel = String(liste.leistungsbereich || tabLabel || liste.titel || "")
        .replace(/\s*\/\s*/g, " / ")
        .replace("Elektroinstallation / DIN VDE 0100", "Elektro / VDE 0100")
        .replace("Kabeltragsysteme / Verlegesysteme", "Kabeltragsysteme")
        .replace("Niederspannungsschaltanlagen / Verteilungen", "NSHV / Verteilungen")
        .replace("Datentechnik / Kommunikationsverkabelung", "Datentechnik")
        .replace("Gefahrenmelde- / Alarmanlage", "Gefahrenmeldeanlage")
        .replace("Breitbandkommunikationsanlage", "Breitband")
        .replace("Rauchwarnmelderanlage", "Rauchwarnmelder")
        .replace("Brandschutzabschottungen", "Brandschutz"); %>
      <button class="device-main-tab" type="button" data-device-main-target="<%= liste.id %>" title="<%= liste.titel || liste.leistungsbereich %>">
        <%- include("icon", { name: "list" }) %>
        <span><%= shortLabel || tabLabel || liste.titel %></span>
        <strong><%= liste.positionen ? liste.positionen.length : 0 %></strong>
      </button>
    <% }) %>
  </nav>
<% } else if (projectTabs.includes(active)) { %>
  <%# * INFO: Projektbereich: Haupttabs bleiben fachlich schlank, Archiv und Import liegen im Projektmanager. %>
  <% tabs = [
    ["projekte", "/projekte#projekt-auswahl", "Projektübersicht", "overview"],
    ["projekt", "/projekt", "Stammdaten", "edit"],
    ["leistungsbereiche", "/leistungsbereiche", "Leistungsbereiche", "list"]
  ]; %>
<% } else if (documentationTabs.includes(active)) { %>
  <%# Dokumentationsbereich: kategorisierte Anhänge/Nachweise. Die Matrix liegt im Exportbereich. %>
  <% tabs = [
    ["anhaenge", "/anhaenge?kategorie=Brandschutz", "Brandschutz", "shield"],
    ["anhaenge", "/anhaenge?kategorie=Stromlaufpläne", "Stromlaufpläne", "file"],
    ["anhaenge", "/anhaenge?kategorie=Schaltpläne", "Schaltpläne", "file"],
    ["anhaenge", "/anhaenge?kategorie=Installationspläne", "Installationspläne", "file"],
    ["anhaenge", "/anhaenge?kategorie=Schemata", "Schemata", "file"],
    ["anhaenge", "/anhaenge?kategorie=Messprotokolle", "Messprotokolle", "file"],
    ["anhaenge", "/anhaenge?kategorie=Bedienungsanleitungen", "Bedienungsanleitungen", "file"],
    ["anhaenge", "/anhaenge?kategorie=Fotos", "Fotos", "image"],
    ["anhaenge", "/anhaenge?kategorie=Pläne", "Weitere Pläne", "file"],
    ["anhaenge", "/anhaenge?kategorie=Nachweise", "Nachweise", "file"],
    ["anhaenge", "/anhaenge?kategorie=Allgemein", "Allgemein", "paperclip"]
  ]; %>
<% } else if (outputTabs.includes(active)) { %>
  <%# Exportbereich: Vorschau, Schritte, Ordnerstruktur und Exportliste. %>
  <% tabs = [
    ["export", "/export#pdf", "PDF-Vorschau", "file"],
    ["export", "/export#vorschau", "Exportstruktur", "grid"],
    ["export", "/export#aktionen", "Schritte", "export"],
    ["export", "/export#struktur", "Ordnerstruktur", "folder-tree"],
    ["export", "/export#liste", "Exportliste", "list"]
  ]; %>
<% } else if (systemTabs.includes(active)) { %>
  <%# Systembereich: globale Einstellungen und Formularvorlagen. %>
  <% tabs = [
    ["einstellungen", "/einstellungen#system", "Grundeinstellungen", "system"],
    ["einstellungen", "/einstellungen#ersteller", "Erstellerstammdaten", "project"],
    ["einstellungen", "/einstellungen#leistungsbereiche-admin", "Leistungsbereiche", "list"],
    ["einstellungen", "/einstellungen#ordnerstruktur", "Ordnerstruktur", "folder-tree"],
    ["einstellungen", "/einstellungen#formulare", "Formulare", "file"]
  ]; %>
<% } %>

<% if (!hasDeviceListTabs && tabs.length) { %>
  <%# Gemeinsames Rendering der Bereichsnavigation mit optionalem Projektmanager. %>
  <% const navTitle = projectTabs.includes(active) ? "Projekte" : documentationTabs.includes(active) ? "Anhänge" : outputTabs.includes(active) ? "Export" : "System"; %>
  <% const navSubtitle = projectTabs.includes(active) ? "Auswahl, Stammdaten und Projektvorgaben" : documentationTabs.includes(active) ? "Pläne, Bilder und Nachweise" : outputTabs.includes(active) ? "PDF, Archiv und Ausgabe" : "Vorgaben und Vorlagen"; %>
  <nav class="section-tabs" aria-label="Bereichsnavigation">
    <div class="section-tabs-head">
      <span><%= navTitle %></span>
      <strong><%= navSubtitle %></strong>
    </div>
    <% tabs.forEach(([key, href, label, icon]) => { %>
      <% const hrefCategory = href.includes("?kategorie=") ? decodeURIComponent(href.split("?kategorie=")[1] || "") : ""; %>
      <% const isAttachmentTab = key === "anhaenge" && active === "anhaenge"; %>
      <% const isCurrentAttachmentTab = isAttachmentTab
        ? (hrefCategory ? selectedCategoryValue === hrefCategory : !selectedCategoryValue)
        : active === key && !href.includes("#"); %>
      <a class="<%= isCurrentAttachmentTab ? "active" : "" %>" href="<%= href %>"><%- include("icon", { name: icon || "file" }) %><span><%= label %></span></a>
    <% }) %>
    <% if (projectTabs.includes(active) && typeof projectSidebarProjects !== "undefined" && Array.isArray(projectSidebarProjects)) { %>
      <% const activeProjects = projectSidebarProjects.filter((project) => project.status === "aktiv"); %>
      <% const archiveProjects = projectSidebarProjects.filter((project) => project.status !== "aktiv"); %>
      <div class="section-tabs-group">
        <div class="section-tabs-subhead">
          <span>Projektmanager</span>
          <form action="/projekte" method="post" class="section-plus-form" title="Neues Projekt">
            <input type="hidden" name="projektname" value="Neues Projekt">
            <input type="hidden" name="auftragGewerk" value="Elektrotechnik">
            <button class="section-plus-button" type="submit" aria-label="Neues Projekt anlegen">+</button>
          </form>
        </div>
        <% activeProjects.forEach((project) => { %>
          <% const isCurrentProject = project.id === currentProjectId; %>
          <form action="/projekte/<%= project.id %>/oeffnen" method="post">
            <button class="section-project-item <%= isCurrentProject ? "active" : "" %>" type="submit">
              <%- include("icon", { name: "project" }) %>
              <span><%= project.projektname || project.id %></span>
              <% if (isCurrentProject) { %><strong>aktiv</strong><% } %>
            </button>
          </form>
        <% }) %>
        <div class="section-tabs-divider"></div>
        <a class="section-project-item section-project-link" href="/projekte#projekt-archiv">
          <%- include("icon", { name: "archive" }) %>
          <span>Archiv</span>
          <strong><%= archiveProjects.length %></strong>
        </a>
        <a class="section-project-item section-project-link" href="/projektarchiv">
          <%- include("icon", { name: "folder-tree" }) %>
          <span>Import / Pakete</span>
        </a>
      </div>
    <% } %>
  </nav>
<% } %>
