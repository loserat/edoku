          <div class="assistant-actions"><a class="secondary" href="<%= base %>?ansicht=angaben">Rückfragen</a><a class="secondary" href="<%= base %>?ansicht=export">Export</a></div><section class="settings-panel"><h2>Auftrag und Rückmeldung</h2><details><summary>Ursprünglicher Auftrag</summary><p class="assistant-preserve"><%= selected.instruction %></p></details><% if (selected.message) { %><details><summary>Letzte Rückmeldung des Agenten</summary><p class="assistant-preserve"><%= selected.message %></p></details><% } %></section>
          <details><summary>Geklärte und überholte Rückfragen</summary><% selected.questions.filter(question => question.answer || question.obsolete).forEach(question => { %><article><h3><%= question.prompt %></h3><p><%= question.obsolete ? question.obsolete.reason : question.answer %></p><% if (question.evidence?.kind === 'chat') { %><p class="field-hint">Aus dem Chat übernommen: <%= question.evidence.sourceLabel %> · <%= question.evidence.sourceQuote %></p><% } %></article><% }) %></details>
          <details><summary>Ersetzte Entwürfe, zurückgezogene und abgelehnte Dateien</summary><% selected.documents.filter(document => ['superseded','rejected','withdrawn'].includes(document.state)).forEach(document => { %><p><a href="<%= base %>/dateien/<%= document.id %>"><%= document.title %></a> · <%= document.state === 'withdrawn' ? 'Zurückgezogen' : document.state === 'superseded' ? 'Durch neuere Fassung ersetzt' : 'Abgelehnt' %><%= document.withdrawal ? ' · ' + document.withdrawal.reason : document.rejectionReason ? ' · ' + document.rejectionReason : '' %></p><% }) %></details>
          <% if (selected.status !== 'closed') { %><details><summary>Auftrag abschließen</summary><p>Erst nach allen erforderlichen Angaben und Dateientscheidungen.</p><form action="<%= base %>/abschliessen" method="post"><%- include('formSecurity') %><button type="submit" class="secondary">Auftrag abschließen</button></form></details><% } %>

<details><summary>Bearbeitungsverlauf</summary><% const labels = {resume:'Wieder aufgenommen',deferred:'Zurückgestellt',not_found:'Nicht gefunden',awaiting_user:'Benutzerangabe ausstehend',awaiting_manufacturer:'Herstellerunterlage ausstehend',unsuitable:'Inhalt unpassend'}; workHistory.forEach(item => { %><article><strong><%= labels[item.state] || item.state %></strong><p><%= item.reason %></p><small><%= new Date(item.recordedAt).toLocaleString('de-DE',{timeZone:'Europe/Berlin'}) %></small></article><% }) %><% if (!workHistory.length) { %><p>Noch keine gesonderten Bearbeitungsentscheidungen gespeichert.</p><% } %></details>
