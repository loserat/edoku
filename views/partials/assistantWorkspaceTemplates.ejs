<% workspace.rows.forEach((row,index) => { if (row.href) return; %>
<template id="work-<%= index %>"><div class="assistant-drawer-content"><p class="eyebrow"><%= row.projectLabel %></p><h2><%= row.title %></h2><nav class="assistant-project-actions"><a href="<%= row.base %>?ansicht=angaben">Alle Angaben</a><a href="<%= row.base %>?ansicht=export">Ausgabe</a></nav>
  <% if (row.record) { %><p class="assistant-notice"><%= row.record.reason %></p><% if (row.record.resumeCondition) { %><p>Weiter bei: <%= row.record.resumeCondition %></p><% } %><% } %>
  <% if (row.question) { %><form action="<%= row.base %>/antworten" method="post" class="stack-form" data-assistant-answer><%- include('formSecurity') %><label><span>Deine Antwort</span><textarea name="answers[<%= row.question.id %>]" rows="3" maxlength="2000" required></textarea></label><button type="submit" class="success-button">Antwort speichern</button></form><% if (row.question.context) { %><details><summary>Hintergrund</summary><p><%= row.question.context %></p></details><% } %><% } else { %><p>Die passende Originaldatei im Agentenchat bereitstellen. Neue Dateivorschläge erscheinen hier zur Einzelprüfung.</p><% } %>
  <% if (row.target && row.job.status !== 'closed') { %><details <%- row.record ? 'open' : '' %>><summary><%= row.record ? 'Bearbeitung wieder aufnehmen' : 'Punkt zurückstellen' %></summary><form action="<%= row.base %>/arbeit" method="post" class="stack-form"><%- include('formSecurity') %><input type="hidden" name="target" value="<%= JSON.stringify(row.target) %>"><input type="hidden" name="revision" value="<%= row.revision %>"><input type="hidden" name="jobVersion" value="<%= row.job.version %>"><input type="hidden" name="state" value="<%= row.record ? 'resume' : 'deferred' %>"><label><span><%= row.record ? 'Was hat sich geändert?' : 'Grund' %></span><textarea name="reason" rows="2" minlength="10" maxlength="1000" required></textarea></label><% if (!row.record) { %><label><span>Weiter, sobald … (optional)</span><input name="resumeCondition" maxlength="500"></label><% } %><button type="submit" class="secondary"><%= row.record ? 'Wieder aufnehmen' : 'Zurückstellen' %></button></form></details><% } %>
</div></template><% }) %>
<% [['material-input','Material hinzufügen','Materialliste'],['agent-request','Auftrag formulieren','Ergänzender Auftrag']].forEach(([id,title,label]) => { %>
<template id="<%= id %>"><div class="assistant-drawer-content"><h2><%= title %></h2><% if (entries.length) { %><form action="/assistent/auftraege/<%= entries[0].job.id %>/ergaenzen" method="post" class="stack-form" data-job-addition><%- include('formSecurity') %><label><span>Zielauftrag</span><select name="jobId" data-job-target><% entries.filter(e => e.job.status !== 'closed').forEach(entry => { %><option value="<%= entry.job.id %>" data-version="<%= entry.job.version %>"><%= entry.project?.projektname || entry.job.projectId %> · <%= entry.project?.projektnummer || entry.job.id %></option><% }) %></select></label><input type="hidden" name="jobVersion" value="<%= entries[0].job.version %>"><input type="hidden" name="kind" value="<%= id === 'material-input' ? 'material' : 'instruction' %>"><label><span><%= label %></span><textarea name="text" rows="9" minlength="10" maxlength="8000" required></textarea></label><button type="submit" class="success-button">Im Auftrag speichern</button></form><p class="field-hint">Der verbundene Agent liest die Ergänzung beim nächsten Abruf. Dateien werden weiterhin einzeln vorgeschlagen und manuell freigegeben.</p><% } else { %><p>Zuerst eine Dokumentation beauftragen.</p><% } %><a class="secondary" href="/assistent?ansicht=auftraege&neu=1">Neue Dokumentation beauftragen</a></div></template><% }) %>
