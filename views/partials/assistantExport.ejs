      <section class="settings-panel"><div class="panel-head"><div><h2>Ausgabe vorbereiten</h2><p>Der Auftrag wartet auf benötigte Angaben und deine Dateifreigaben. Danach werden die freigegebenen Quellen zu einer getrennten Ausgabe zusammengestellt.</p></div></div>
        <% if (projectReadiness?.datasheets && !projectReadiness.datasheets.complete) { %><p class="assistant-notice">Datenblätter noch unvollständig. Offene Artikel unter „Datenblätter“ prüfen; ein technisch erzeugter Export bestätigt keine vollständige Artikelabdeckung.</p><% } %>
        <div class="assistant-output-checks"><p>Pflichtangaben und Quellen: <strong><%= projectReadiness.inputComplete ? 'Vorhanden' : 'Offen' %></strong> · Dateiprüfungen: <strong><%= projectReadiness.reviewComplete ? 'Erledigt' : 'Offen' %></strong></p></div><form action="/assistent/auftraege/<%= selected.id %>/export" method="post"><%- include('formSecurity') %><input type="hidden" name="requestId" value="<%= exportRequestId %>"><button type="submit" class="success-button"<%= !projectReadiness.inputComplete || !projectReadiness.reviewComplete || !projectReadiness.datasheets?.complete ? ' disabled' : '' %>>PDF und ZIP vorbereiten</button></form>
        <% const exportLabels = { queued: 'Wartet auf Verarbeitung', waiting_input: 'Benötigte Angaben oder Pflichtquellen fehlen', waiting_review: 'Wartet auf deine Dateifreigaben', running: 'PDF und ZIP werden erzeugt', succeeded: 'Technisch vollständig erzeugt', incomplete: 'Ausgabe unvollständig – keine finalen Downloads', failed: 'Erzeugung fehlgeschlagen', cancelled: 'Abgebrochen', stale: 'Projekt oder Quellen wurden während der Erzeugung geändert' }; %>
        <% exportRuns.forEach(run => { %><article class="assistant-document"><strong><%= exportLabels[run.state] %></strong><p>Erzeugungsversuch <%= run.attempt %> · <%= new Date(run.updatedAt).toLocaleString('de-DE', { timeZone: 'Europe/Berlin' }) %></p>
          <% if (run.inputRevision) { %><p class="field-hint">Projektstand: <%= run.inputRevision %><%= run.current ? '' : ' · aktueller Projektstand weicht ab' %></p><% } %>
          <% if (run.result?.readiness?.issues?.length) { %><details><summary>Offene Voraussetzungen anzeigen</summary><ul><% run.result.readiness.issues.forEach(issue => { %><li><%= issue.message %></li><% }) %></ul></details><% } %>
          <% if (run.result?.missingOutputs?.length) { %><ul><% run.result.missingOutputs.forEach(output => { %><li><%= output.title %>: <%= output.status %></li><% }) %></ul><% } %>
          <% if (run.errorCode) { %><p>Fehlerkennung: <code><%= run.errorCode %></code></p><% } %>
          <div class="assistant-actions"><% run.files.forEach(file => { %><a class="secondary" href="/assistent/projekte/<%= selected.projectId %>/exporte/<%= run.id %>/dateien/<%= file.kind %>"><%= { pdf: 'Gesamt-PDF herunterladen', zip: 'ZIP herunterladen', report: 'Erzeugungsbericht herunterladen' }[file.kind] %></a><% }) %></div>
          <% if (['queued','waiting_input','waiting_review','running'].includes(run.state)) { %><form action="/assistent/auftraege/<%= selected.id %>/exporte/<%= run.id %>/abbrechen" method="post"><%- include('formSecurity') %><button type="submit" class="secondary">Diesen Export abbrechen</button></form><% } %>
          <% if (['failed','incomplete','cancelled','stale'].includes(run.state)) { %><form action="/assistent/auftraege/<%= selected.id %>/exporte/<%= run.id %>/erneut" method="post"><%- include('formSecurity') %><button type="submit" class="secondary">Voraussetzungen neu prüfen und erneut versuchen</button></form><% } %>
        </article><% }) %>
        <p class="field-hint">Die technische Erzeugung ersetzt keine fachliche Abnahme. Ein neuer Auftragsstand wird oben angekündigt; über „Neuen Stand laden“ bleiben deine Eingaben bis zum bewussten Neuladen erhalten.</p>
      </section>
