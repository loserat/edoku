<%# Wiederverwendbares PDF-Popup für Vorschau-Buttons in Listen und Exportansichten. %>
<div class="pdf-modal" data-pdf-modal hidden>
  <div class="pdf-modal-backdrop" data-pdf-modal-close></div>
  <section class="pdf-modal-panel" role="dialog" aria-modal="true" aria-label="PDF-Vorschau">
    <header class="pdf-modal-head">
      <strong data-pdf-modal-title>PDF-Vorschau</strong>
      <button class="secondary" type="button" data-pdf-modal-close>Schließen</button>
    </header>
    <iframe title="PDF-Vorschau" data-pdf-modal-frame src="about:blank"></iframe>
  </section>
</div>
