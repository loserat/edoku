<div class="assistant-file-controls"><nav class="assistant-filters" aria-label="Datenblattauswahl"><% [['open','Offene Artikel'],['all','Alle Artikel']].forEach(([value,label]) => { %><a href="<%= base %>?ansicht=datenblaetter&amp;deckung=<%= value %><%= typeof scope !== 'undefined' ? scope : '' %>" <%- coverageFilter === value ? 'aria-current="page"' : '' %>><%= label %></a><% }) %></nav><label class="assistant-search"><span class="sr-only">Artikel suchen</span><input type="search" placeholder="Artikel suchen …" data-file-search></label></div>
