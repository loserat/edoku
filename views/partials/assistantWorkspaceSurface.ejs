  <header class="assistant-heading assistant-clean-heading"><div><p class="eyebrow"><span class="sr-only">Aktuelles Projekt: </span><%= [activeProject.projektname || activeProject.id, activeProject.projektnummer].filter(Boolean).join(' · ') %></p><h1>Doku-Assistent</h1></div><div class="assistant-actions"><button type="button" class="secondary" data-work-detail="material-input">Material hinzufügen</button><button type="button" class="secondary" data-work-detail="agent-request">Auftrag formulieren</button></div></header>
  <div class="assistant-workspace-nav assistant-clean-nav"><nav class="assistant-nav" aria-label="Dokumentationsauftrag"><% [['uebersicht','Offene Punkte',workspace.rows.length],['dateien','Dateien prüfen',workspace.counts.files],['datenblaetter','Datenblätter',workspace.counts.approved + ' / ' + workspace.counts.articles],['export','Ausgabe',null],['verlauf','Verlauf',null]].forEach(([value,label,count]) => { %><a href="<%= base %>?ansicht=<%= value %><%= scope %>" <%- section === value || (value === 'uebersicht' && section === 'angaben') ? 'aria-current="page"' : '' %>><%= label %><% if (count !== null) { %><span><%= count %></span><% } %></a><% }) %></nav><details class="assistant-clean-settings"><summary>Einstellungen</summary><div class="assistant-clean-settings-body"><%- include('assistantMaterialPolicy') %><a href="/einstellungen#api">MCP-Verbindung</a></div></details></div>
  <% if (section === 'uebersicht') { %><%- include('assistantNextAction') %><%- include('assistantWorklist') %><% } %>
  <% if (section === 'auftraege') { %><%- include('assistantStart', { statuses }) %><% } %>
  <% if (section === 'dateien') { %>
    <% if (workspace.counts.files) { const firstFile = workspace.groups.find(group => group.id === 'file').rows[0]; %><div class="assistant-file-start"><span><strong><%= workspace.counts.files %></strong> Dateien warten auf Einzelprüfung</span><a class="secondary" data-review-link href="<%= firstFile.href %>">Datei prüfen →</a></div><% } %>
    <div class="assistant-file-controls"><nav class="assistant-filters" aria-label="Dateistatus"><% [['pending','Zu prüfen'],['approved','Übernommen'],['all','Alle']].forEach(([value,label]) => { %><a href="<%= base %>?ansicht=dateien&filter=<%= value %><%= scope %>" <%- fileFilter === value ? 'aria-current="page"' : '' %>><%= label %></a><% }) %></nav><label class="assistant-search"><span class="sr-only">Dateien suchen</span><input type="search" data-file-search placeholder="Datei suchen …"></label></div>
  <% } %>
  <% if (section === 'datenblaetter') { %><%- include('assistantDatasheetControls', { base, scope }) %><% } %>
  <% if (['dateien','datenblaetter','export','verlauf','angaben'].includes(section)) { %>
    <% if (!entries.length) { %><p class="assistant-empty">Kein offener Auftrag in dieser Auswahl.</p><% } %>
    <% entries.forEach(entry => { const jobBase = '/assistent/auftraege/' + entry.job.id; %>
      <section class="assistant-dashboard-job" data-file-group><% if (!selected && entries.length > 1) { %><h2 class="assistant-entry-heading"><a href="<%= jobBase %>"><%= [entry.project?.projektname || entry.job.projectId,entry.project?.projektnummer].filter(Boolean).join(' · ') %></a></h2><% } %>
      <% if (section === 'dateien') { const groups = categories.map(category => ({ category, documents: [...entry.pending,...entry.approved].filter(d => d.category === category && (fileFilter === 'all' || d.state === fileFilter)).sort((a,b) => (a.state === 'pending' ? 0 : 1) - (b.state === 'pending' ? 0 : 1) || compareReviewDocuments(a,b)) })).filter(g => g.documents.length); %><%- include('assistantFiles', { base: jobBase, pending: entry.pending, approved: entry.approved, documentGroups: groups, showControls: false }) %><% } %>
      <% if (section === 'datenblaetter') { %><%- include('assistantDatasheets', { datasheetCoverage: entry.datasheetCoverage }) %><% } %>
      <% if (section === 'angaben') { %><%- include('assistantQuestions', { selected: entry.job, base: jobBase, openQuestions: entry.openQuestions, agentIssues: entry.agentIssues, projectReadiness: entry.projectReadiness }) %><% } %>
      <% if (section === 'export') { %><%- include('assistantExport', { selected: entry.job, exportRuns: entry.exportRuns, projectReadiness: entry.projectReadiness }) %><% } %>
      <% if (section === 'verlauf') { %><%- include('assistantHistory', { selected: entry.job, base: jobBase, workHistory: entry.workHistory || [] }) %><% } %>
      </section>
    <% }) %>
    <% if (['dateien','datenblaetter'].includes(section)) { %><p data-file-empty hidden>Kein passender Eintrag gefunden.</p><% } %>
  <% } %>
  <%- include('assistantWorkspaceTemplates') %>
