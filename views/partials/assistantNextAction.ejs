<% const next = workspace.next; %>
<section class="assistant-next assistant-focus-action" aria-label="Nächste Aktion">
  <div><p class="assistant-next-label"><%= next ? (next.kind === 'file' ? 'Bereit zur Einzelprüfung' : next.kind === 'question' ? 'Deine Angabe fehlt' : 'Unterlagen ergänzen') : workspace.counts.waiting ? 'Punkte zurückgestellt oder blockiert' : 'Aktueller Stand' %></p><h2><%= next ? next.title : workspace.counts.waiting ? 'Aktuell keine weitere aktive Aufgabe' : 'Keine offenen Aufgaben in dieser Ansicht' %></h2><p><%= next ? (next.kind === 'file' ? workspace.counts.files + ' Dateien offen · Jede Datei einzeln prüfen.' : next.subtitle) : workspace.counts.waiting ? workspace.counts.waiting + ' Punkte unter „Wartet“ prüfen.' : 'Neue Vorschläge erscheinen hier.' %></p></div>
  <% if (next) { if (next.href) { %><a class="success-button" href="<%= next.href %>" <%- next.kind === 'file' ? 'data-review-link' : '' %>><%= next.kind === 'file' ? 'Datei prüfen' : 'Details öffnen' %> →</a><% } else { %><button type="button" class="success-button" data-work-detail="work-<%= workspace.rows.indexOf(next) %>"><%= next.kind === 'question' ? 'Angabe ergänzen' : 'Details öffnen' %> →</button><% } } else if (workspace.counts.waiting) { %><button type="button" class="secondary" data-work-filter="waiting">Wartende Punkte ansehen</button><% } else if (!entries.length) { %><a class="secondary" href="/assistent?ansicht=auftraege&amp;neu=1">Dokumentation beauftragen</a><% } %>
</section>
