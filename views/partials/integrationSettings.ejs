<%
  const scopeLabels = { "projects:read": "Projekte und Stammdaten lesen", "projects:write": "Projektstammdaten ändern", "devices:read": "Gerätelisten lesen", "devices:write": "Gerätepositionen anlegen und ändern", "documents:read": "Dokumente, Brandschutz und Anhangsmetadaten lesen", "assistant:read": "Assistentenaufträge und Entscheidungen lesen", "assistant:write": "Aufträge, Rückfragen und Dateivorschläge vorbereiten (keine Freigabe)", "exports:read": "Exportaufträge und freigegebene Ausgaben lesen", "exports:write": "Hintergrundexporte beauftragen und steuern" };
  const keyStates = { active: "Aktiv", expired: "Abgelaufen", revoked: "Widerrufen", disabled: "Konto gesperrt", password_changed: "Durch Passwortwechsel ungültig" };
  const projectNames = new Map(availableProjects.map(project => [project.id, project.projektname || project.id]));
%>
<section id="api-integrations" class="integration-settings integration-clean" data-settings-panel="api" data-integration-origin="<%= integrationOrigin %>" hidden>
  <header class="integration-heading"><div><h2>API &amp; MCP</h2><p>Verbinden und Zugriffe verwalten.</p></div><span class="badge <%= integrationSettings.apiEnabled ? 'on' : 'off' %>"><%= !integrationSettings.apiEnabled ? 'API aus' : integrationSettings.allowWrites ? 'API aktiv' : 'Nur lesen' %></span></header>
  <nav class="integration-nav" aria-label="API und MCP Bereiche"><% [['connection','Verbindung'],['setup','Einrichten'],['keys','Zugänge'],['tools','Werkzeuge'],['advanced','Erweitert']].forEach(([id,label])=>{ %><button type="button" class="secondary" data-integration-tab="<%= id %>" aria-pressed="<%= id === 'connection' %>"><%= label %><% if(id==='tools'){ %><span><%= integrationOverview.total %></span><% } %></button><% }) %></nav>
  <% if (integrationError) { %><p class="notice error" data-persistent><%= integrationError %></p><% } %>
  <% if (createdToken) { %>
    <section class="settings-panel integration-new-key" data-created-key-panel>
      <h3>Neuer Schlüssel: <%= createdToken.name %></h3><p>Jetzt kopieren. Der vollständige Schlüssel wird nur einmal angezeigt.</p>
      <label><span>API-Schlüssel</span><textarea readonly rows="3" data-created-key autocomplete="off" spellcheck="false"><%= createdToken.token %></textarea></label>
      <div class="integration-actions"><button type="button" class="secondary compact-button" data-copy-target="[data-created-key]">Schlüssel kopieren</button><button type="button" class="secondary compact-button" data-use-created-key>Für MCP-Einrichtung übernehmen</button><button type="button" class="secondary compact-button" data-hide-created-key>Schlüssel ausblenden</button></div>
    </section>
  <% } %>

  <section data-integration-pane="connection" class="settings-panel">
    <div class="integration-status-grid"><div><span>API / MCP</span><strong><%= apiVersion %> / <%= mcpVersion %></strong></div><div><span>Server-Werkzeuge</span><strong><%= integrationOverview.total %><small><%= integrationOverview.read %> Lesen · <%= integrationOverview.write %> Ändern</small></strong></div><div><span>Eigene aktive Zugänge</span><strong><%= apiKeys.filter(key=>key.state==='active').length %></strong></div></div>
    <div class="integration-actions"><button type="button" class="success-button compact-button" data-integration-go="setup">Verbindung einrichten</button><a class="secondary compact-button" href="/assistent">Doku-Assistent öffnen</a></div>
    <div class="integration-actions"><span class="badge <%= integrationSettings.apiEnabled && integrationSettings.remoteMcpEnabled ? 'on' : 'off' %>">Remote-MCP <%= integrationSettings.apiEnabled && integrationSettings.remoteMcpEnabled ? 'aktiviert' : 'aus' %></span><code><%= integrationOrigin %>/mcp</code><button type="button" class="secondary compact-button" data-copy-text="<%= integrationOrigin %>/mcp">MCP-URL kopieren</button></div>
    <p class="field-hint">Remote benötigt die öffentliche HTTPS-Adresse. Standardmäßig nur lesen; Änderungen zusätzlich über <code>?access=write</code> und passende Schlüsselrechte.</p>
    <h3>Server &amp; Rechte prüfen</h3><p class="field-hint">Prüft diesen edoku-Server. Der externe MCP-Client wird hier nicht gestartet.</p>
    <form data-integration-diagnosis class="stack-form"><div class="form-grid compact"><label><span>Eigener Schlüssel</span><select name="keyId"><option value="">Nur Server prüfen</option><% apiKeys.forEach(key=>{ %><option value="<%= key.id %>"><%= key.name %> · <%= keyStates[key.state] %></option><% }) %></select></label><label><span>Benötigtes Profil</span><select name="profile"><% integrationOverview.profiles.forEach(profile=>{ %><option value="<%= profile.id %>"><%= profile.label %></option><% }) %></select></label><label><span>Projekt (optional)</span><select name="projectId"><option value="">Ohne Projektprüfung</option><% availableProjects.forEach(project=>{ %><option value="<%= project.id %>"><%= project.projektname || project.id %></option><% }) %></select></label></div><div><button type="submit" class="secondary compact-button">Diagnose starten</button></div></form>
    <ul class="integration-diagnostics" data-diagnosis-result aria-live="polite"></ul>
    <p class="field-hint">Dateien werden weiterhin ausschließlich einzeln manuell freigegeben.</p>
  </section>
  <section data-integration-pane="setup" class="settings-panel" hidden id="mcp-setup">
    <h3>MCP-Verbindung einrichten</h3>
    <ol class="integration-steps" aria-label="Einrichtungsschritte"><li data-step-label="0" aria-current="step">1 · Betriebsart</li><li data-step-label="1">2 · Zugang</li><li data-step-label="2">3 · Konfiguration</li></ol>
    <form class="stack-form" data-mcp-setup novalidate>
      <div data-mcp-step="0" class="stack-form">
        <label><span>Betriebsart</span><select data-mcp-mode><option value="node">Direkt mit Node.js</option><option value="docker">Lokaler Docker-Container</option><option value="remote">Remote per HTTPS-URL</option></select></label>
        <div class="form-grid compact"><label><span>edoku-Serveradresse</span><input type="url" data-mcp-url value="<%= integrationOrigin %>" required autocomplete="off"><small data-mcp-address-hint>Docker vor Ort: meist http://127.0.0.1:3000 im Container.</small></label><label data-mcp-script-field><span>Starter auf dem Rechner des MCP-Clients</span><input type="text" data-mcp-script placeholder="/Pfad/zu/edoku/scripts/edoku-mcp.js" required autocomplete="off" spellcheck="false"><small data-mcp-mode-hint>Node.js 22 und edoku-Abhängigkeiten erforderlich.</small></label></div>
        <label data-mcp-container-field hidden><span>Containername</span><input type="text" data-mcp-container value="edoku_v1" autocomplete="off"><small>Docker muss dort laufen. Der Starter verändert keine Container oder Zugänge.</small></label>
        <div><button type="button" class="success-button compact-button" data-mcp-next>Weiter →</button></div>
      </div>
      <div data-mcp-step="1" class="stack-form" hidden>
        <label><span>API-Schlüssel</span><input type="password" data-mcp-token autocomplete="off" spellcheck="false" required placeholder="edoku_…"><small>Vorhandenen Schlüssel eingeben oder unter „Zugänge“ einen neuen anlegen.</small></label>
        <label class="integration-choice"><input type="checkbox" data-mcp-writes><span>Änderungen anbieten</span></label>
        <p class="field-hint">Server und Schlüssel müssen Änderungen ebenfalls erlauben. Keine automatische Dateifreigabe.</p>
        <p class="field-hint" data-mcp-remote-hint hidden>Auf dem VPS unter „Erweitert“ Remote-MCP einschalten. HTTPS und APP_ORIGIN müssen eingerichtet sein. Dein Client benötigt URL und Bearer-Header; OAuth wird nicht angeboten.</p><details data-mcp-local-files><summary>Lokale Dateiübergabe (optional)</summary><label><span>Freigegebener Eingangsordner</span><input type="text" data-mcp-document-root autocomplete="off" spellcheck="false" placeholder="/Pfad/zu/Dokumenten"><small>Bei Docker ein vorhandener Ordner im Container, ausdrücklich schreibgeschützt eingebunden. Hersteller-PDF-Prüfungen über die API benötigen diesen lokalen Ordner nicht.</small></label></details>
        <div class="integration-actions"><button type="button" class="secondary compact-button" data-mcp-back="0">← Zurück</button><button type="button" class="secondary compact-button" data-check-token>Zugang hier prüfen</button><button type="button" class="success-button compact-button" data-mcp-build>Konfiguration erstellen →</button></div>
      </div>
      <div data-mcp-step="2" data-mcp-result class="stack-form" hidden>
        <p>Im MCP-Client eintragen und dort die Verbindung starten.</p><label><span>MCP-Konfiguration (JSON)</span><textarea readonly rows="14" data-mcp-config spellcheck="false" autocomplete="off"></textarea></label>
        <div class="integration-actions"><button type="button" class="secondary compact-button" data-mcp-back="1">← Zurück</button><button type="button" class="success-button compact-button" data-copy-target="[data-mcp-config]">Konfiguration kopieren</button><button type="button" class="secondary compact-button" data-copy-probe>Prüfauftrag kopieren</button><button type="button" class="secondary compact-button" data-clear-mcp>Geheimnisse ausblenden</button></div>
        <p class="field-hint">Enthält deinen Schlüssel. Nur privat im MCP-Client speichern. Docker-Neustarts schließen laufende STDIO-Verbindungen; den Client danach neu verbinden.</p>
      </div>
      <p data-mcp-status role="status" aria-live="polite"></p>
    </form>
  </section>
  <div data-integration-pane="keys" class="stack-form" hidden>
    <section class="settings-panel"><h3>Deine Zugänge</h3><ul class="integration-key-list">
      <% if (!apiKeys.length) { %><li>Noch keine Schlüssel vorhanden.</li><% } %>
      <% apiKeys.forEach(key=>{ const profile=integrationOverview.profiles.find(p=>p.scopes.length===key.scopes.length && p.scopes.every(scope=>key.scopes.includes(scope))); %>
      <li><div class="integration-key-heading"><strong><%= key.name %></strong><span class="badge <%= key.state==='active'?'on':'off' %>"><%= keyStates[key.state] %></span></div><p class="field-hint"><%= profile?.label || 'Eigene Rechte' %> · bis <%= new Date(key.expiresAt).toLocaleDateString('de-DE',{timeZone:'Europe/Berlin'}) %> · <%= key.projectIds===null?'Alle eigenen Projekte':key.projectIds.length+' Projekte' %></p>
        <details><summary>Rechte und Projekte</summary><ul><% key.scopes.forEach(scope=>{ %><li><%= scopeLabels[scope] || scope %></li><% }) %></ul><p><%= key.projectIds===null?'Alle eigenen Projekte einschließlich zukünftiger':key.projectIds.map(id=>projectNames.get(id)||id).join(', ') %></p></details>
        <% if(!key.revokedAt && user.role!=='viewer'){ %><form method="post" action="/integrationen/schluessel/<%= key.id %>/widerrufen#api" data-confirm="API-Schlüssel wirklich widerrufen? Verbundene Programme verlieren damit den Zugriff."><%- include('formSecurity') %><button type="submit" class="secondary danger compact-button">Widerrufen</button></form><% } %>
      </li><% }) %></ul><p class="field-hint">Bestehende Schlüssel werden durch die Einrichtung nicht verändert. Vollständige Schlüssel werden nur bei ihrer Erstellung angezeigt.</p></section>
    <section class="settings-panel">
      <div class="panel-head"><div><h3>Eigenen API-Schlüssel anlegen</h3><p>Zum Beispiel für ein externes Programm oder deinen MCP-Client.</p></div></div>
      <% if (user.role === "viewer") { %><p>Lesekonten können hier keine neuen Schlüssel anlegen.</p><% } else { %>
        <form action="/integrationen/schluessel#api" method="post" class="stack-form" data-api-key-form>
          <%- include("formSecurity") %>
          <div class="form-grid compact">
            <label><span>Name</span><input type="text" name="name" required maxlength="80" placeholder="Zum Beispiel: MCP am Arbeitsplatz"></label>
            <label><span>Gültigkeit in Tagen</span><input name="days" type="number" min="1" max="<%= integrationSettings.maxTokenDays %>" value="<%= integrationSettings.defaultTokenDays %>" required></label>
          </div>
          <fieldset class="integration-options"><legend>Berechtigungsprofil</legend><button type="button" class="secondary compact-button" data-assistant-key-preset="read">Nur lesen</button>
            <button type="button" class="secondary compact-button" data-assistant-key-preset="research">Unterlagen vorbereiten</button>
            <button type="button" class="secondary compact-button" data-assistant-key-preset="full">Projekt vollständig bearbeiten</button>
            <details><summary>Einzelne Rechte anzeigen</summary>
            <% apiScopes.forEach(scope => { %><label class="integration-choice"><input type="checkbox" name="scopes" value="<%= scope %>"<%= scope.endsWith(':read') ? ' checked' : '' %>><span><%= scopeLabels[scope] %></span></label><% }) %>
            </details>
          </fieldset>
          <fieldset class="integration-options"><legend>Freigegebene Projekte</legend>
            <label class="integration-choice"><input type="radio" name="projectMode" value="selected" checked><span>Nur ausgewählte Projekte</span></label>
            <label class="integration-choice"><input type="radio" name="projectMode" value="all"><span>Alle eigenen Projekte, einschließlich zukünftiger</span></label>
            <div class="integration-projects" data-key-projects>
              <% if (!availableProjects.length) { %><p class="field-hint">Noch keine eigenen Projekte vorhanden.</p><% } %>
              <% availableProjects.forEach(project => { %><label class="integration-choice"><input type="checkbox" name="projectIds" value="<%= project.id %>"><span><%= project.projektname || project.id %><small><%= project.projektnummer || project.id %></small></span></label><% }) %>
            </div>
          </fieldset>
          <p class="field-hint">„Projekt vollständig bearbeiten“ enthält auch geschützte Lösch- und Resetfunktionen. Dateien bleiben immer manuell einzeln freizugeben.</p>
          <p class="field-hint">Zum Ändern auch das passende Leserecht auswählen. So kann das Programm den aktuellen Projektstand vor der Änderung prüfen.</p>
          <div><button type="submit" class="success-button compact-button">API-Schlüssel anlegen</button></div>
        </form>
      <% } %>
    </section>
  </div>
  <section data-integration-pane="tools" class="settings-panel" hidden><div class="panel-head"><div><h3>Werkzeugübersicht</h3><p>Server-Katalog · API-Schlüssel und Client bestimmen den tatsächlichen Zugriff.</p></div></div>
    <div class="integration-tool-controls"><label><span class="sr-only">Werkzeuge suchen</span><input type="search" data-tool-search maxlength="80" placeholder="Werkzeug oder Aufgabe suchen …"></label><label><span class="sr-only">Werkzeugbereich</span><select data-tool-group><option value="all">Alle Bereiche</option><% integrationOverview.groups.forEach(group=>{ %><option value="<%= group.id %>"><%= group.label %> (<%= group.count %>)</option><% }) %></select></label><label><span class="sr-only">Werkzeugart</span><select data-tool-mode><option value="all">Alle Aktionen</option><option value="read">Nur lesen</option><option value="write">Ändern</option><option value="sensitive">Löschen / Wiederherstellen</option></select></label></div>
    <p data-tool-status role="status" aria-live="polite"></p><ul class="integration-tool-list" data-tool-list></ul><div class="integration-actions"><button type="button" class="secondary compact-button" data-tool-prev disabled>← Zurück</button><button type="button" class="secondary compact-button" data-tool-next disabled>Weiter →</button></div>
  </section>
  <div data-integration-pane="advanced" class="stack-form" hidden>    <section class="settings-panel">
      <div class="panel-head"><div><h3>Serverzugang</h3><p>Diese Vorgaben gelten für alle API-Schlüssel und auch für Zugriffe über MCP.</p></div></div>
      <% if (isSystemAdmin) { %>
        <form action="/einstellungen/integrationen#api" method="post" class="stack-form">
          <%- include("formSecurity") %>
          <label class="switch-control"><input type="checkbox" name="apiEnabled"<%= integrationSettings.apiEnabled ? ' checked' : '' %>><span class="switch-track" aria-hidden="true"></span><span>API-Zugang aktivieren</span></label>
          <label class="switch-control"><input type="checkbox" name="remoteMcpEnabled"<%= integrationSettings.remoteMcpEnabled ? ' checked' : '' %>><span class="switch-track" aria-hidden="true"></span><span>Remote-MCP per HTTPS erlauben</span></label>
          <label class="switch-control"><input type="checkbox" name="allowWrites"<%= integrationSettings.allowWrites ? ' checked' : '' %>><span class="switch-track" aria-hidden="true"></span><span>Änderungen über die API erlauben</span></label>
          <p class="field-hint">Ohne Schreibzugriffe bleiben alle Schlüssel auf Lesen beschränkt. Ihre eigenen Rechte gelten zusätzlich. Beim Ausschalten werden Schlüssel erhalten und können weiterhin widerrufen werden.</p>
          <div class="form-grid compact">
            <label><span>Standardgültigkeit neuer Schlüssel</span><input name="defaultTokenDays" type="number" min="1" max="365" value="<%= integrationSettings.defaultTokenDays %>" required><small>Tage</small></label>
            <label><span>Maximale Gültigkeit neuer Schlüssel</span><input name="maxTokenDays" type="number" min="1" max="365" value="<%= integrationSettings.maxTokenDays %>" required><small>Tage, höchstens 365</small></label>
          </div>
          <p class="field-hint">Eine neue Gültigkeitsvorgabe verändert keine bereits ausgegebenen Schlüssel.</p>
          <div><button type="submit" class="success-button compact-button">API-Einstellungen speichern</button></div>
        </form>
      <% } else { %>
        <p>Den Serverzugang und die Gültigkeitsvorgaben verwaltet ein Systemadmin. Du kannst unten deine eigenen Schlüssel verwalten.</p>
        <p>Neue Schlüssel: standardmäßig <strong><%= integrationSettings.defaultTokenDays %> Tage</strong>, höchstens <strong><%= integrationSettings.maxTokenDays %> Tage</strong>.</p>
      <% } %>
    </section>

<section class="settings-panel"><h3>Technische Informationen</h3><label><span>API-Adresse</span><code><%= integrationOrigin %>/api/v1</code></label><div class="integration-actions"><a class="secondary compact-button" href="/api/v1/openapi.json" target="_blank" rel="noopener">API-Beschreibung öffnen</a><button type="button" class="secondary compact-button" data-copy-text="<%= integrationOrigin %>/api/v1">API-Adresse kopieren</button></div><p class="field-hint">MCP: lokal über STDIO oder direkt per HTTPS unter <code>/mcp</code>. Remote benötigt einen API-Schlüssel im Bearer-Header. OAuth wird nicht angeboten.</p></section></div>
  <p data-integration-copy-status role="status" aria-live="polite"></p>
</section>
