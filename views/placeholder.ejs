<!doctype html>
<html lang="de">
  <head>
    <%- include("partials/head", { pageTitle: title }) %>
  </head>
  <body>
    <%- include("partials/header", { active }) %>
    <main id="main-content" tabindex="-1" class="page">
      <div class="page-title">
        <p class="eyebrow">Modul</p>
        <h1><%= heading %></h1>
      </div>
      <%- include("partials/sectionTabs", { active }) %>
      <section class="config-preview">
        <p><%= text %></p>
      </section>
    </main>
    <%- include("partials/footer") %>
    <script src="/js/app.js"></script>
  </body>
</html>
