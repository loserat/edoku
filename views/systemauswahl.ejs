<!doctype html>
<html lang="de">
<head><%- include('partials/head',{pageTitle:'Hersteller & Systeme'}) %></head>
<body>
<%- include('partials/header',{active}) %>
<main id="main-content" tabindex="-1" class="page wide compact-work-page">
  <div class="page-title"><p class="eyebrow">Projekt</p><h1>Hersteller &amp; Systeme</h1><p class="page-subtitle">Mehrere Zuordnungen je Leistungsbereich. Geräte und Dateifreigaben bleiben erhalten.</p></div>
  <%- include('partials/flash',{flash}) %><%- include('partials/sectionTabs',{active}) %>
  <% const areas=systemConfig.leistungsbereiche.filter(area=>activeAreas.includes(area.name)); %>
  <% if(!areas.length){ %><p>Zuerst die passenden <a href="/leistungsbereiche">Leistungsbereiche auswählen</a>.</p><% } %>
  <% areas.forEach((area,index)=>{ const rows=selections.get(area.name)?.selections||[]; %>
    <section class="settings-panel stack-form" data-system-area="<%= area.name %>">
      <div class="panel-head"><h2><%= area.name %></h2><span class="badge"><%= rows.filter(row=>row.enabled!==false).length %> Zuordnungen</span></div>
      <div data-system-rows>
        <% rows.forEach(row=>{ %><%- include('partials/systemSelection',{area,row,isNew:false}) %><% }) %>
        <% if(!rows.length){ %><p class="field-hint">Noch keine Hersteller-/Systemzuordnung gespeichert.</p><% } %>
      </div>
      <button type="button" class="secondary" data-add-system="system-template-<%= index %>">Hersteller / System hinzufügen</button>
      <template id="system-template-<%= index %>"><%- include('partials/systemSelection',{area,row:{},isNew:true}) %></template>
    </section>
  <% }) %>
</main>
<%- include('partials/footer') %>
<script type="application/json" id="multi-system-config"><%- jsonForHtml(systemConfig) %></script>
<script src="/js/app.js"></script><script src="/js/systemauswahl.js"></script>
</body></html>
