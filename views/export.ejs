<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Export | edoku</title>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <%# Exportansicht: bündelt PDF-Vorschau, Exportstruktur, Aktionen und finale Exportliste. %>
    <%- include("partials/header", { active }) %>
    <main class="page compact-work-page full-width-page">
      <div class="page-title">
        <p class="eyebrow">Ausgabe</p>
        <h1>Export</h1>
        <p class="page-subtitle">Projektordner, interne PDFs, Exportliste und finalen Vorbereitungsordner schrittweise erzeugen.</p>
      </div>

      <%- include("partials/flash", { flash }) %>

      <%# Kleine Statuszählung für die kompakten Export-Kennzahlen. %>
      <% const vorhanden = exportliste.filter((entry) => entry.status === "vorhanden").length; %>
      <% const fehlt = exportliste.filter((entry) => entry.status === "fehlt").length; %>
      <% const finalFiles = finalExportFiles || []; %>
      <% const completePdf = finalFiles.find((file) => file.kind === "gesamt-pdf"); %>
      <% const zipFile = finalFiles.find((file) => file.kind === "zip"); %>
      <% const orderFile = finalFiles.find((file) => file.kind === "reihenfolge"); %>
      <% const separatorPdf = pdfPreviewFiles.find((file) => /Trennstreifen/i.test(file.name)); %>
      <%# * INFO: Gespeicherte Trennstreifen-Optionen werden in den Switches wiederhergestellt. %>
      <% const separatorSettings = (((systemSettings || {}).export || {}).trennstreifen || {}); %>
      <% const selectedPdf = (completePdf && pdfPreviewFiles.find((file) => file.id === completePdf.id)) || pdfPreviewFiles[0]; %>
      <% const formatSize = (bytes) => {
        if (!bytes) return "-";
        if (bytes < 1024) return `${bytes} B`;
        if (bytes < 1024 * 1024) return `${Math.round(bytes / 1024)} KB`;
        return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
      }; %>

      <div data-tabs="export-v2" class="export-tab-shell export-scroll">
        <nav class="tabs export-tabs" aria-label="Exportbereiche">
          <button class="tab-button" type="button" data-tab-target="matrix">Matrix</button>
          <button class="tab-button" type="button" data-tab-target="pdf-dokumentation">PDF-Dokumentation</button>
          <button class="tab-button" type="button" data-tab-target="pdf-trennstreifen">PDF-Trennstreifen</button>
          <button class="tab-button" type="button" data-tab-target="zip-export">ZIP-Export</button>
          <button class="tab-button" type="button" data-tab-target="export-einstellungen">Exporteinstellungen</button>
        </nav>

        <section id="matrix" class="tab-panel export-panel" data-tab-panel="matrix">
          <div class="panel-head">
            <div>
              <h2>Matrix</h2>
              <p>Hier wird nur festgelegt, welche vorhandenen Systemdokumente erzeugt und exportiert werden.</p>
            </div>
          </div>

          <form action="/export/matrix" method="post" data-autosave>
            <div class="table-wrap matrix-nowrap-wrap">
              <table class="matrix-table matrix-nowrap-table" data-resizable-table data-resize-key="export-matrix">
                <thead>
                  <tr>
                    <th>Kapitel</th>
                    <th>Original</th>
                    <th>Titel</th>
                    <th>Ausgabe</th>
                    <th>Pflicht</th>
                    <th>Leistungsbereich</th>
                    <th>Dokumenttyp</th>
                    <th>Formularart</th>
                    <th>Quelle</th>
                    <th>Bemerkung</th>
                  </tr>
                </thead>
                <tbody>
                  <% dokumente.forEach((dokument) => { %>
                    <tr class="<%= dokument.aktiv ? "row-active" : "" %> level-<%= dokument.ebene %>">
                      <td><strong><%= dokument.displayKapitel || "-" %></strong></td>
                      <td><small><%= dokument.originalKapitel || dokument.kapitel %></small></td>
                      <td class="title-cell"><%= dokument.titel %></td>
                      <td>
                        <label class="cell-check">
                          <input type="checkbox" name="export" value="<%= dokument.id %>" <%= dokument.export ? "checked" : "" %>>
                          <span>Ausgabe</span>
                        </label>
                      </td>
                      <td><span class="badge <%= dokument.pflicht ? "on" : "off" %>"><%= dokument.pflicht ? "Ja" : "Nein" %></span></td>
                      <td><%= [dokument.leistungsbereich, ...(Array.isArray(dokument.leistungsbereiche) ? dokument.leistungsbereiche : [])].filter(Boolean).join(", ") %></td>
                      <td><%= dokument.dokumenttyp %></td>
                      <td><%= dokument.formularart %></td>
                      <td><%= dokument.quelle %></td>
                      <td><%= dokument.bemerkung %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </form>
        </section>

        <%# Browser-Vorschau vorhandener PDF-Dateien aus generiert/final/externer Ablage. %>
        <section id="pdf" class="tab-panel export-panel" data-tab-panel="pdf-dokumentation">
          <div class="panel-head">
            <div>
              <h2>PDF-Dokumentation</h2>
              <p>Interne Dokumentations-PDFs erzeugen und direkt prüfen.</p>
            </div>
            <% if (pdfPreviewFiles.length) { %>
              <label class="compact-select">
                <span>Datei</span>
                <select data-pdf-preview-select>
                  <% pdfPreviewFiles.forEach((file) => { %>
                    <option value="/export/pdf-preview?file=<%= encodeURIComponent(file.id) %>" <%= selectedPdf && file.id === selectedPdf.id ? "selected" : "" %>>
                      <%= file.source %> - <%= file.name %>
                    </option>
                  <% }) %>
                </select>
              </label>
            <% } %>
          </div>

          <section class="export-actions export-actions-compact">
            <form class="export-action-primary" action="/export/dokumentation" method="post">
              <button type="submit">
                <span>Dokumentation generieren</span>
                <small>Inhaltsverzeichnis, Deckblätter, Formulare, Listen und Brandschutz neu erzeugen</small>
              </button>
            </form>
            <form action="/export/inhaltsverzeichnis" method="post">
              <button class="secondary" type="submit">
                <span>Inhaltsverzeichnis</span>
                <small>Nur Inhaltsverzeichnis neu erzeugen</small>
              </button>
            </form>
            <form action="/export/formulare" method="post">
              <button class="secondary" type="submit">
                <span>Formulare</span>
                <small>Konformität, CE, DGUV und Errichterbestätigung</small>
              </button>
            </form>
            <form action="/export/geraetelisten" method="post">
              <button class="secondary" type="submit">
                <span>Gerätelisten</span>
                <small>Tabellen-PDFs für aktive Gerätelisten erzeugen</small>
              </button>
            </form>
            <form action="/export/brandschutz" method="post">
              <button class="secondary" type="submit">
                <span>Brandschutz</span>
                <small>Brandschottungen als Bilddokumentation erzeugen</small>
              </button>
            </form>
          </section>

          <% if (selectedPdf) { %>
            <div class="pdf-preview-shell">
              <iframe
                title="PDF-Vorschau"
                src="/export/pdf-preview?file=<%= encodeURIComponent(selectedPdf.id) %>#toolbar=1"
                data-pdf-preview-frame>
              </iframe>
            </div>
          <% } else { %>
            <div class="pdf-empty">
              <strong>Noch keine PDF für die Vorschau vorhanden.</strong>
              <span>Erzeuge zuerst die Dokumentation, danach erscheint die Vorschau hier automatisch.</span>
            </div>
          <% } %>
        </section>

        <section id="trennstreifen" class="tab-panel export-panel" data-tab-panel="pdf-trennstreifen">
          <div class="panel-head">
            <div>
              <h2>PDF-Trennstreifen</h2>
              <p>Separate Registerstreifen im Maß 24 x 10,5 cm für Unterkategorien erzeugen.</p>
            </div>
          </div>

          <section class="export-artifacts export-artifacts-single" aria-label="Trennstreifen">
            <article class="export-artifact-card <%= separatorPdf ? "" : "is-missing" %>">
              <div class="export-artifact-card-head">
                <div>
                  <span>Registerstreifen</span>
                  <strong><%= separatorPdf ? separatorPdf.name : "Noch nicht erzeugt" %></strong>
                </div>
                <span class="badge <%= separatorPdf ? "on" : "off" %>"><%= separatorPdf ? "bereit" : "fehlt" %></span>
              </div>
              <p>Standard: rechts nur die Kapitelnummer in Schwarz, ohne farbigen Registerkasten.</p>
              <div class="export-artifact-meta">
                <small><%= separatorPdf ? "In PDF-Vorschau verfügbar" : "Separat erzeugen" %></small>
              </div>
              <div class="export-artifact-actions">
                <%# * INFO: Diese Optionen beeinflussen nur das Layout der separat erzeugten Registerstreifen. %>
                <form class="separator-options-form" action="/export/trennstreifen" method="post">
                  <label class="switch-control compact-toggle">
                    <input type="checkbox" name="showInnenText" value="1" <%= separatorSettings.showInnenText ? "checked" : "" %>>
                    <span class="switch-track" aria-hidden="true"></span>
                    <span>Innenbereich mit Titel drucken</span>
                  </label>
                  <label class="switch-control compact-toggle">
                    <input type="checkbox" name="showRegisterTitel" value="1" <%= separatorSettings.showRegisterTitel ? "checked" : "" %>>
                    <span class="switch-track" aria-hidden="true"></span>
                    <span>Registertitel zusätzlich anzeigen</span>
                  </label>
                  <button type="submit">Trennstreifen erzeugen</button>
                </form>
                <% if (separatorPdf) { %>
                  <a class="button-link secondary" href="/export/pdf-preview?file=<%= encodeURIComponent(separatorPdf.id) %>#toolbar=1">Vorschau</a>
                <% } %>
              </div>
            </article>
          </section>
        </section>

        <section id="zip" class="tab-panel export-panel" data-tab-panel="zip-export">
          <div class="panel-head">
            <div>
              <h2>ZIP-Export</h2>
              <p>Finale Gesamt-PDF und ZIP-Datei mit passender Ordnerstruktur vorbereiten.</p>
            </div>
          </div>

          <%# Finale Export-Artefakte: Gesamt-PDF, ZIP und Reihenfolgeliste aus dem finalen Projektordner. %>
          <section class="export-artifacts" aria-label="Finale Exportdateien">
            <article class="export-artifact-card <%= completePdf ? "" : "is-missing" %>">
              <div class="export-artifact-card-head">
                <div>
                  <span>Gesamt-PDF</span>
                  <strong><%= completePdf ? completePdf.name : "Noch nicht erzeugt" %></strong>
                </div>
                <span class="badge <%= completePdf ? "on" : "off" %>"><%= completePdf ? "bereit" : "fehlt" %></span>
              </div>
              <p>Zusammengeführte Dokumentation für Prüfung und Versand.</p>
              <div class="export-artifact-meta">
                <small><%= completePdf ? formatSize(completePdf.size) : "Finalen Export vorbereiten" %></small>
              </div>
              <% if (completePdf) { %>
                <div class="export-artifact-actions">
                  <a class="button-link" href="/export/pdf-preview?file=<%= encodeURIComponent(completePdf.id) %>#toolbar=1">Vorschau</a>
                  <a class="button-link secondary" href="/export/download?file=<%= encodeURIComponent(completePdf.id) %>">Download</a>
                </div>
              <% } %>
            </article>

            <article class="export-artifact-card <%= zipFile ? "" : "is-missing" %>">
              <div class="export-artifact-card-head">
                <div>
                  <span>ZIP-Export</span>
                  <strong><%= zipFile ? zipFile.name : "Noch nicht erzeugt" %></strong>
                </div>
                <span class="badge <%= zipFile ? "on" : "off" %>"><%= zipFile ? "bereit" : "fehlt" %></span>
              </div>
              <p>Ordnerstruktur mit PDFs passend zur Exportreihenfolge.</p>
              <div class="export-artifact-meta">
                <small><%= zipFile ? formatSize(zipFile.size) : "Finalen Export vorbereiten" %></small>
              </div>
              <% if (zipFile) { %>
                <div class="export-artifact-actions">
                  <a class="button-link secondary" href="/export/download?file=<%= encodeURIComponent(zipFile.id) %>">Download</a>
                </div>
              <% } %>
            </article>

            <article class="export-artifact-card <%= orderFile ? "" : "is-missing" %>">
              <div class="export-artifact-card-head">
                <div>
                  <span>Export-Reihenfolge</span>
                  <strong><%= orderFile ? orderFile.name : "Noch nicht erzeugt" %></strong>
                </div>
                <span class="badge <%= orderFile ? "on" : "off" %>"><%= orderFile ? "bereit" : "fehlt" %></span>
              </div>
              <p>Textprotokoll der finalen Sortierung und ausgelassenen Dateien.</p>
              <div class="export-artifact-meta">
                <small><%= orderFile ? formatSize(orderFile.size) : "Finalen Export vorbereiten" %></small>
              </div>
              <% if (orderFile) { %>
                <div class="export-artifact-actions">
                  <a class="button-link secondary" href="/export/download?file=<%= encodeURIComponent(orderFile.id) %>">Download</a>
                </div>
              <% } %>
            </article>
          </section>

          <section class="export-actions export-actions-compact">
            <form class="export-action-primary" action="/export/final" method="post">
              <button type="submit">
                <span>Finalen Export vorbereiten</span>
                <small>Gesamt-PDF, ZIP und Reihenfolge-Datei neu erzeugen</small>
              </button>
            </form>
          </section>
        </section>

        <%# Logische Exportstruktur mit fortlaufenden Kapitelnummern und Dateistatus. %>
        <section id="einstellungen" class="tab-panel export-panel" data-tab-panel="export-einstellungen">
          <div class="panel-head">
            <div>
              <h2>Exporteinstellungen</h2>
              <p>Exportstruktur prüfen, Ordnerstruktur anzeigen und Exportliste aktualisieren.</p>
            </div>
          </div>

          <section class="export-actions export-actions-compact">
            <form action="/export/exportliste" method="post">
              <button type="submit">
                <span>Exportliste prüfen</span>
                <small>Reihenfolge, Anhänge und Dateistatus aktualisieren</small>
              </button>
            </form>
            <form action="/export/pdfs-loeschen" method="post" data-confirm="Alle generierten und finalen PDFs dieses Projekts löschen?">
              <button class="danger" type="submit">
                <span>PDFs löschen</span>
                <small>Generierte und finale Dateien entfernen</small>
              </button>
            </form>
          </section>

          <section class="preview-head">
            <div>
              <span>Projekt</span>
              <strong><%= preview.projekt.projektname %></strong>
              <small><%= preview.projekt.projektnummer %></small>
            </div>
            <div>
              <span>Auftraggeber</span>
              <strong><%= preview.projekt.auftraggeber %></strong>
              <small><%= preview.projekt.liegenschaft %></small>
            </div>
            <div>
              <span>Baumaßnahme</span>
              <strong><%= preview.projekt.baumassnahme %></strong>
              <small><%= preview.stats.kapitel %> Kapitelgruppen</small>
            </div>
          </section>

          <section class="summary-cards preview-stats">
            <div class="summary-card"><span>Export-Dokumente</span><strong><%= preview.stats.dokumente %></strong></div>
            <div class="summary-card"><span>Pflicht</span><strong><%= preview.stats.pflichtdokumente %></strong></div>
            <div class="summary-card"><span>Fehlende Pflicht</span><strong><%= preview.stats.fehlendePflicht %></strong></div>
            <div class="summary-card"><span>Vorhandene Dateien</span><strong><%= preview.stats.vorhandeneDateien %></strong></div>
            <div class="summary-card"><span>Fehlende Dateien</span><strong><%= preview.stats.fehlendeDateien %></strong></div>
            <div class="summary-card"><span>Nicht geprüft</span><strong><%= preview.stats.ungeprueft %></strong></div>
          </section>

          <% if (!preview.groups.length) { %>
            <p class="empty-state">Noch keine aktiven Export-Dokumente vorhanden.</p>
          <% } %>

          <div class="export-preview">
            <% preview.groups.forEach((group) => { %>
              <section class="preview-chapter">
                <h3><span><%= group.kapitel %></span><%= group.titel %></h3>
                <ol class="preview-list">
                  <% group.dokumente.forEach((doc) => { %>
                    <li class="preview-item level-<%= doc.ebene %>">
                      <div class="preview-title">
                        <strong><%= doc.kapitel %></strong>
                        <span><%= doc.titel %></span>
                      </div>
                      <div class="preview-meta">
                        <small>Original: <%= doc.originalKapitel || "-" %></small>
                        <% if (doc.leistungsbereich) { %><small><%= doc.leistungsbereich %></small><% } %>
                        <% if (doc.hersteller || doc.systemart) { %><small><%= doc.hersteller || "-" %> / <%= doc.systemart || "-" %></small><% } %>
                        <span class="badge <%= doc.statusClass %>"><%= doc.status %></span>
                        <% if (doc.pflicht) { %><span class="badge required">Pflicht</span><% } %>
                      </div>
                      <% if (doc.dateipfad) { %>
                        <small class="preview-path"><%= doc.dateipfad %></small>
                      <% } %>
                    </li>
                  <% }) %>
                </ol>
              </section>
            <% }) %>
          </div>

          <div class="panel-head export-subsection-head">
            <div>
              <h2>Projektordner-Struktur</h2>
              <p>Externe PDFs können später in `02_Config_Projekt` in die passenden Kapitelordner gelegt werden.</p>
            </div>
          </div>
          <ul class="compact-list">
            <% (ordnerstruktur.unterordner || []).forEach((ordner) => { %>
              <li><%= ordner %></li>
            <% }) %>
          </ul>

          <div class="panel-head export-subsection-head">
            <div>
              <h2>Exportliste</h2>
              <p>Reihenfolge, Quellenstatus und Hersteller-/Systembezug.</p>
            </div>
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Reihenfolge</th>
                  <th>Kapitel</th>
                  <th>Original</th>
                  <th>Titel</th>
                  <th>Dateipfad</th>
                  <th>Quelle</th>
                  <th>Status</th>
                  <th>Pflicht</th>
                  <th>Hersteller / Systemart</th>
                </tr>
              </thead>
              <tbody>
                <% if (!exportliste.length) { %>
                  <tr>
                    <td colspan="9">Noch keine Exportliste erzeugt.</td>
                  </tr>
                <% } %>
                <% exportliste.forEach((entry) => { %>
                  <tr class="<%= entry.pflicht && entry.status === "fehlt" ? "row-missing-required" : "" %>">
                    <td><%= entry.reihenfolge %></td>
                    <td><%= entry.kapitel %></td>
                    <td><small><%= entry.originalKapitel || "-" %></small></td>
                    <td><%= entry.titel %></td>
                    <td><%= entry.dateipfad || "-" %></td>
                    <td><%= entry.quelle %></td>
                    <td><span class="badge <%= entry.status === "vorhanden" ? "on" : "off" %>"><%= entry.status %></span></td>
                    <td><%= entry.pflicht ? "Ja" : "Nein" %></td>
                    <td>
                      <%= entry.hersteller || "-" %>
                      <% if (entry.systemart) { %>
                        <br><small><%= entry.systemart %></small>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </main>
    <%- include("partials/footer") %>
    <script src="/js/app.js"></script>
  </body>
</html>
