<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Einstellungen | edoku</title>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <%# Systemeinstellungen: globale Defaults, Erstellerdaten und Formularvorlagen. %>
    <%- include("partials/header", { active }) %>
    <main class="page wide compact-work-page settings-page">
      <div class="page-title">
        <p class="eyebrow">Konfiguration</p>
        <h1>Einstellungen</h1>
        <p class="page-subtitle">Default-Formulare bearbeiten und Layoutwirkung direkt prüfen.</p>
      </div>

      <%- include("partials/flash", { flash }) %>

      <% const theme = systemSettings.theme || {}; %>
      <% const themeColors = theme.colors || {}; %>
      <% const themeShape = theme.shape || {}; %>
      <% const themeShadow = theme.shadow || {}; %>
      <% const themeSpacing = theme.spacing || {}; %>
      <% const themeTypography = theme.typography || {}; %>

      <%# Obere Einstellungsnavigation statt linker/rechter Sidebar. %>
      <nav class="settings-top-tabs" aria-label="Einstellungsbereiche" data-settings-tabs>
        <button type="button" data-settings-tab="system" aria-controls="system"><%- include("partials/icon", { name: "system" }) %><span>System</span></button>
        <button type="button" data-settings-tab="theme" aria-controls="theme-editor"><%- include("partials/icon", { name: "system" }) %><span>Theme</span></button>
        <button type="button" data-settings-tab="ersteller" aria-controls="ersteller"><%- include("partials/icon", { name: "project" }) %><span>Ersteller</span></button>
        <button type="button" data-settings-tab="leistungsbereiche" aria-controls="leistungsbereiche-admin"><%- include("partials/icon", { name: "list" }) %><span>Leistungsbereiche</span></button>
        <button type="button" data-settings-tab="geraetelisten-vorlagen" aria-controls="geraetelisten-vorlagen"><%- include("partials/icon", { name: "list" }) %><span>Gerätelisten</span></button>
        <button type="button" data-settings-tab="ordnerstruktur" aria-controls="ordnerstruktur"><%- include("partials/icon", { name: "folder-tree" }) %><span>Ordnerstruktur</span></button>
        <button type="button" data-settings-tab="updates" aria-controls="updates"><%- include("partials/icon", { name: "download" }) %><span>Updates</span></button>
        <% if (isSystemAdmin) { %>
          <button type="button" data-settings-tab="benutzer" aria-controls="benutzerverwaltung"><%- include("partials/icon", { name: "overview" }) %><span>Benutzer</span></button>
        <% } %>
      </nav>

      <%# Übersicht und Einstellungsbereiche bleiben auf einer Seite, Auto-Save speichert je Formular. %>
      <section class="settings-grid">
        <%# Allgemeine Systemwerte für Oberfläche, Export und PDF-Grunddaten. %>
        <form id="system" action="/einstellungen/system" method="post" data-autosave class="settings-panel" data-settings-panel="system">
          <div class="panel-head">
            <div>
              <h2>System-Grundeinstellungen</h2>
              <p>Allgemeine Defaults für Oberfläche, Export und PDF-Ausgaben.</p>
            </div>
          </div>
          <div class="form-grid compact">
            <label>
              <span>App-Titel</span>
              <input type="text" name="appTitel" value="<%= systemSettings.appTitel %>">
            </label>
            <label>
              <span>Standard-Gewerk</span>
              <input type="text" name="standardGewerk" value="<%= systemSettings.standardGewerk %>">
            </label>
            <label>
              <span>Standard-Einheit</span>
              <input type="text" name="standardEinheit" value="<%= systemSettings.standardEinheit %>">
            </label>
            <label>
              <span>Export-Präfix</span>
              <input type="text" name="exportOrdnerPrefix" value="<%= systemSettings.exportOrdnerPrefix %>">
            </label>
            <label>
              <span>Datumsformat</span>
              <input type="text" name="datumFormat" value="<%= systemSettings.datumFormat %>">
            </label>
            <label>
              <span>PDF-Footer</span>
              <input type="text" name="pdfFooterText" value="<%= systemSettings.pdfFooterText %>">
            </label>
          </div>
          <label class="switch-control">
            <input type="checkbox" name="autosaveHinweis" <%= systemSettings.autosaveHinweis ? "checked" : "" %>>
            <span class="switch-track" aria-hidden="true"></span>
            <span>Auto-Save-Hinweis anzeigen</span>
          </label>
          <label class="switch-control">
            <input type="checkbox" name="deleteConfirmDialogs" <%= systemSettings.deleteConfirmDialogs !== false ? "checked" : "" %>>
            <span class="switch-track" aria-hidden="true"></span>
            <span>Löschbestätigung anzeigen</span>
          </label>
          <% if (isSystemAdmin) { %>
            <label class="switch-control">
              <input type="checkbox" name="brandingAktiv" <%= !systemSettings.lizenz || systemSettings.lizenz.brandingAktiv !== false ? "checked" : "" %>>
              <span class="switch-track" aria-hidden="true"></span>
              <span>edoku-Branding in Oberfläche und PDF anzeigen</span>
            </label>
            <p class="field-hint">Nur für Systemadmins: Für Vollversionen kann das sichtbare edoku/nickgm-Branding deaktiviert werden. Projekt- und Erstellerlogos bleiben davon unabhängig.</p>
          <% } %>
        </form>

        <%# Versionsbereich: zeigt lokale Version, Release Notes und eine reine GitHub-Prüfung ohne Auto-Update. %>
        <section id="updates" class="settings-panel" data-settings-panel="updates" hidden>
          <div class="panel-head">
            <div>
              <h2>Version und Updates</h2>
              <p>Installierte Version prüfen und lokale Release Notes lesen.</p>
            </div>
          </div>
          <section class="system-update-panel" aria-label="Version und Updates">
            <div class="version-summary">
              <div>
                <span class="meta-label">Installierte Version</span>
                <strong><%= appName %> <%= appVersion %></strong>
              </div>
              <button type="button" class="secondary compact-button" data-update-check>Updates prüfen</button>
            </div>
            <p class="update-status" data-update-status>Noch nicht geprüft.</p>
            <details class="release-notes-panel" open>
              <summary>Aktuelle Release Notes</summary>
              <pre class="release-notes-body"><%= releaseNotes %></pre>
            </details>
          </section>
        </section>

        <%# Theme-Editor: zentrale Designwerte werden in systemEinstellungen.json gespeichert. %>
        <form id="theme-editor" action="/einstellungen/theme" method="post" class="settings-panel theme-editor" data-theme-editor data-settings-panel="theme" hidden>
          <div class="panel-head">
            <div>
              <h2>Theme-Editor</h2>
              <p>Farben, Radien, Schatten, Abstände und Typografie zentral steuern.</p>
            </div>
            <div class="panel-actions">
              <button type="submit">Theme speichern</button>
              <button class="secondary" type="submit" formaction="/einstellungen/theme/defaults" formmethod="post">Zurücksetzen</button>
            </div>
          </div>

          <section class="theme-preset-bar" aria-label="Theme-Presets">
            <% Object.entries(themePresets || {}).forEach(([presetKey, preset]) => { %>
              <button class="secondary theme-preset-button" type="button" data-theme-preset="<%= presetKey %>"><%= preset.name %></button>
            <% }) %>
          </section>

          <input type="hidden" name="preset" data-theme-field="preset" value="<%= theme.preset || "github-light" %>">
          <input type="hidden" name="name" data-theme-field="name" value="<%= theme.name || "GitHub Light" %>">

          <div class="theme-editor-layout">
            <section class="theme-editor-controls">
              <section class="theme-editor-group">
                <h3>Theme-Modus</h3>
                <div class="segmented-control">
                  <label><input type="radio" name="mode" value="light" <%= theme.mode === "light" ? "checked" : "" %>><span>Light</span></label>
                  <label><input type="radio" name="mode" value="dark" <%= theme.mode === "dark" ? "checked" : "" %>><span>Dark</span></label>
                </div>
              </section>

              <section class="theme-editor-group">
                <h3>Basisfarben</h3>
                <div class="theme-control-grid">
                  <label><span>Hintergrund hell</span><input type="color" name="bgLight" data-theme-var="--color-bg-light" value="<%= themeColors.bgLight %>"></label>
                  <label><span>Karten / Panels</span><input type="color" name="surface" data-theme-var="--color-surface" value="<%= themeColors.surface %>"></label>
                  <label><span>Panel gedämpft</span><input type="color" name="surfaceMuted" data-theme-var="--color-surface-muted" value="<%= themeColors.surfaceMuted %>"></label>
                  <label><span>Primärtext</span><input type="color" name="text" data-theme-var="--color-text" value="<%= themeColors.text %>"></label>
                  <label><span>Sekundärtext</span><input type="color" name="textMuted" data-theme-var="--color-text-muted" value="<%= themeColors.textMuted %>"></label>
                  <label><span>Akzentfarbe</span><input type="color" name="accent" data-theme-var="--color-primary" value="<%= themeColors.accent %>"></label>
                  <label><span>Rahmenfarbe</span><input type="color" name="border" data-theme-var="--color-border" value="<%= themeColors.border %>"></label>
                  <label><span>Button primär</span><input type="color" name="buttonPrimary" data-theme-var="--color-button-primary" value="<%= themeColors.buttonPrimary %>"></label>
                  <label><span>Button sekundär</span><input type="color" name="buttonSecondary" data-theme-var="--color-button-secondary" value="<%= themeColors.buttonSecondary %>"></label>
                </div>
              </section>

              <section class="theme-editor-group">
                <h3>Nachtmodus</h3>
                <div class="theme-control-grid">
                  <label><span>Hintergrund dunkel</span><input type="color" name="bgDark" data-theme-var="--color-bg-dark" value="<%= themeColors.bgDark %>"></label>
                  <label><span>Karten dunkel</span><input type="color" name="surfaceDark" data-theme-var="--color-surface-dark" value="<%= themeColors.surfaceDark %>"></label>
                  <label><span>Panel gedämpft dunkel</span><input type="color" name="surfaceMutedDark" data-theme-var="--color-surface-muted-dark" value="<%= themeColors.surfaceMutedDark %>"></label>
                  <label><span>Primärtext dunkel</span><input type="color" name="textDark" data-theme-var="--color-text-dark" value="<%= themeColors.textDark %>"></label>
                  <label><span>Sekundärtext dunkel</span><input type="color" name="textMutedDark" data-theme-var="--color-text-muted-dark" value="<%= themeColors.textMutedDark %>"></label>
                  <label><span>Rahmen dunkel</span><input type="color" name="borderDark" data-theme-var="--color-border-dark" value="<%= themeColors.borderDark %>"></label>
                </div>
              </section>

              <section class="theme-editor-group">
                <h3>Statusfarben</h3>
                <div class="theme-control-grid">
                  <label><span>Warnfarbe</span><input type="color" name="warning" data-theme-var="--color-warning" value="<%= themeColors.warning %>"></label>
                  <label><span>Fehlerfarbe</span><input type="color" name="danger" data-theme-var="--color-danger" value="<%= themeColors.danger %>"></label>
                  <label><span>Erfolgsfarbe</span><input type="color" name="success" data-theme-var="--color-success" value="<%= themeColors.success %>"></label>
                </div>
              </section>

              <section class="theme-editor-group">
                <h3>Radien und Linien</h3>
                <div class="theme-control-grid">
                  <label><span>Border-Radius global</span><input type="number" min="0" max="40" name="globalRadius" data-theme-var="--radius-sm" data-theme-unit="px" value="<%= themeShape.globalRadius %>"></label>
                  <label><span>Karten-Radius</span><input type="number" min="0" max="48" name="cardRadius" data-theme-var="--radius-lg" data-theme-unit="px" value="<%= themeShape.cardRadius %>"></label>
                  <label><span>Button-Radius</span><input type="number" min="0" max="999" name="buttonRadius" data-theme-var="--radius-button" data-theme-unit="px" value="<%= themeShape.buttonRadius %>"></label>
                  <label><span>Input-Radius</span><input type="number" min="0" max="40" name="inputRadius" data-theme-var="--radius-md" data-theme-unit="px" value="<%= themeShape.inputRadius %>"></label>
                  <label><span>Border-Stärke</span><input type="number" min="0" max="4" step="0.5" name="borderWidth" data-theme-var="--border-width" data-theme-unit="px" value="<%= themeShape.borderWidth %>"></label>
                </div>
              </section>

              <section class="theme-editor-group">
                <h3>Schatten</h3>
                <div class="theme-control-grid">
                  <label><span>Schattenstärke</span><input type="range" min="0" max="60" name="shadowStrength" data-theme-var="--shadow-strength" value="<%= themeShadow.strength %>"></label>
                  <label><span>Schatten-Weichheit</span><input type="range" min="0" max="80" name="shadowSoftness" data-theme-var="--shadow-softness" data-theme-unit="px" value="<%= themeShadow.softness %>"></label>
                </div>
              </section>

              <section class="theme-editor-group">
                <h3>Abstände</h3>
                <div class="theme-control-grid">
                  <label><span>Globales Spacing</span><input type="number" min="4" max="32" name="globalSpacing" data-theme-var="--spacing-md" data-theme-unit="px" value="<%= themeSpacing.global %>"></label>
                  <label><span>Seitenabstand</span><input type="number" min="0" max="48" name="pageSpacing" data-theme-var="--page-spacing" data-theme-unit="px" value="<%= themeSpacing.page %>"></label>
                  <label><span>Kartenabstand</span><input type="number" min="4" max="36" name="cardSpacing" data-theme-var="--card-spacing" data-theme-unit="px" value="<%= themeSpacing.card %>"></label>
                  <label><span>Formularabstand</span><input type="number" min="4" max="32" name="formSpacing" data-theme-var="--form-spacing" data-theme-unit="px" value="<%= themeSpacing.form %>"></label>
                  <label><span>Tabellen-Zeilenhöhe</span><input type="number" min="28" max="72" name="tableRowHeight" data-theme-var="--table-row-height" data-theme-unit="px" value="<%= themeSpacing.tableRowHeight %>"></label>
                </div>
              </section>

              <section class="theme-editor-group">
                <h3>Typografie</h3>
                <div class="theme-control-grid">
                  <label><span>Basis-Schriftgröße</span><input type="number" min="11" max="20" name="fontSizeBase" data-theme-var="--font-size-base" data-theme-unit="px" value="<%= themeTypography.base %>"></label>
                  <label><span>Überschriften-Größe</span><input type="number" min="18" max="42" name="fontSizeHeading" data-theme-var="--font-size-heading" data-theme-unit="px" value="<%= themeTypography.heading %>"></label>
                  <label><span>Label-Größe</span><input type="number" min="10" max="18" name="fontSizeLabel" data-theme-var="--font-size-label" data-theme-unit="px" value="<%= themeTypography.label %>"></label>
                  <label><span>Button-Schriftgröße</span><input type="number" min="11" max="20" name="fontSizeButton" data-theme-var="--font-size-button" data-theme-unit="px" value="<%= themeTypography.button %>"></label>
                  <label><span>Zeilenhöhe</span><input type="number" min="1.1" max="1.9" step="0.01" name="lineHeightBase" data-theme-var="--line-height-base" value="<%= themeTypography.lineHeight %>"></label>
                </div>
              </section>
            </section>

          </div>
        </form>

        <%# Zentrale Erstellerstammdaten inklusive Logo für PDF-Köpfe. %>
        <section id="ersteller" class="settings-panel" data-settings-panel="ersteller" hidden>
          <div class="panel-head">
            <div>
              <h2>Erstellerstammdaten</h2>
              <p>Zentrale Firmen-, Bearbeiter- und Logo-Daten für Formulare und PDF-Ausgaben.</p>
            </div>
          </div>
          <form action="/einstellungen/ersteller" method="post" data-autosave class="stack-form">
            <div class="form-grid compact">
              <label>
                <span>Name</span>
                <input type="text" name="name" value="<%= systemSettings.ersteller.name || "" %>">
              </label>
              <label>
                <span>Firma</span>
                <input type="text" name="firma" value="<%= systemSettings.ersteller.firma || "" %>">
              </label>
              <label>
                <span>Bearbeiter</span>
                <input type="text" name="bearbeiter" value="<%= systemSettings.ersteller.bearbeiter || "" %>">
              </label>
              <label>
                <span>Telefon</span>
                <input type="text" name="telefon" value="<%= systemSettings.ersteller.telefon || "" %>">
              </label>
              <label>
                <span>E-Mail</span>
                <input type="text" name="email" value="<%= systemSettings.ersteller.email || "" %>">
              </label>
              <label>
                <span>Webseite</span>
                <input type="text" name="webseite" value="<%= systemSettings.ersteller.webseite || "" %>">
              </label>
            </div>
            <label>
              <span>Anschrift</span>
              <textarea name="anschrift" rows="3"><%= systemSettings.ersteller.anschrift || "" %></textarea>
            </label>
          </form>

          <div class="logo-import-grid creator-logo-grid">
            <div class="logo-preview-box">
              <% if (systemSettings.ersteller.logoPfad) { %>
                <img src="/einstellungen/ersteller-logo" alt="Erstellerlogo">
                <span><%= systemSettings.ersteller.logoPfad %></span>
                <form action="/einstellungen/ersteller-logo/loeschen" method="post" data-confirm="Zentrales Logo wirklich löschen?">
                  <button class="danger icon-only-button" type="submit" aria-label="Logo löschen"><%- include("partials/icon", { name: "trash" }) %></button>
                </form>
              <% } else { %>
                <strong>Kein zentrales Logo importiert</strong>
                <span>Dieses Logo wird zentral fuer Formulare und PDF-Ausgaben verwendet.</span>
              <% } %>
            </div>
            <form action="/einstellungen/ersteller-logo" method="post" enctype="multipart/form-data" class="logo-upload-form">
              <label>
                <span>Zentrales Logo</span>
                <input type="file" name="logo" accept="image/png,image/jpeg,image/webp" required>
              </label>
              <button class="secondary compact-button" type="submit">Importieren</button>
            </form>
          </div>
        </section>

        <form id="ordnerstruktur" action="/einstellungen/ordnerstruktur" method="post" data-autosave class="settings-panel" data-settings-panel="ordnerstruktur" hidden>
          <div class="panel-head">
            <div>
              <h2>Projektordner</h2>
              <p>Grundstruktur für erzeugte Projektordner.</p>
            </div>
          </div>
          <label>
            <span>Basisordner</span>
            <input type="text" name="basisordner" value="<%= ordnerstruktur.basisordner || "" %>">
          </label>
          <label>
            <span>Unterordner</span>
            <textarea name="unterordner" rows="8"><%= (ordnerstruktur.unterordner || []).join("\n") %></textarea>
          </label>
        </form>

        <% if (isSystemAdmin) { %>
          <section id="benutzerverwaltung" class="settings-panel" data-settings-panel="benutzer" hidden>
            <div class="panel-head">
              <div>
                <h2>Benutzerverwaltung</h2>
                <p>Konten und Rollen für den Zugriff auf Projekte und Systembereiche verwalten.</p>
              </div>
            </div>

            <form action="/einstellungen/benutzer" method="post" class="form-grid compact user-create-form">
              <label>
                <span>Login</span>
                <input type="text" name="email" placeholder="z. B. neuer_user">
              </label>
              <label>
                <span>Name</span>
                <input type="text" name="name" placeholder="Anzeigename">
              </label>
              <label>
                <span>Passwort</span>
                <input type="password" name="password" autocomplete="new-password">
              </label>
              <label>
                <span>Rolle</span>
                <select name="role">
                  <% (userRoles || []).forEach((role) => { %>
                    <option value="<%= role %>" <%= role === "user" ? "selected" : "" %>><%= role %></option>
                  <% }) %>
                </select>
              </label>
              <div class="form-actions-inline">
                <button class="compact-button" type="submit">Benutzer anlegen</button>
              </div>
            </form>

            <div class="table-wrap user-table-wrap">
              <table class="user-admin-table">
                <thead>
                  <tr>
                    <th>Login</th>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Rolle</th>
                    <th>Aktuelles Projekt</th>
                    <th>Aktualisiert</th>
                    <th>Aktionen</th>
                  </tr>
                </thead>
                <tbody>
                  <% (users || []).forEach((account) => { %>
                    <%
                      const updatedLabel = account.updatedAt ? new Date(account.updatedAt).toLocaleString("de-DE", { dateStyle: "short", timeStyle: "short" }) : "-";
                    %>
                    <tr>
                      <td><strong class="user-text-clip"><%= account.email %></strong></td>
                      <td><span class="user-text-clip"><%= account.name %></span></td>
                      <td><span class="badge <%= account.status === "disabled" ? "off" : "on" %>"><%= account.status === "disabled" ? "gesperrt" : "aktiv" %></span></td>
                      <td><span class="badge <%= account.role === "systemadmin" ? "current" : account.role === "viewer" ? "off" : "on" %>"><%= account.role %></span></td>
                      <td><span class="user-text-clip"><%= account.currentProjectId || "-" %></span></td>
                      <td><%= updatedLabel %></td>
                      <td class="user-actions-cell">
                        <button class="secondary compact-button" type="button" data-user-modal-open="<%= account.id %>">Bearbeiten</button>
                        <div class="user-modal" data-user-modal="<%= account.id %>" hidden>
                          <div class="user-modal-backdrop"></div>
                          <section class="user-modal-panel" role="dialog" aria-modal="true" aria-label="Benutzer bearbeiten">
                            <header class="user-modal-head">
                              <div>
                                <strong><%= account.name || account.email %></strong>
                                <span><%= account.email %> · <%= account.status === "disabled" ? "gesperrt" : "aktiv" %></span>
                              </div>
                              <button class="secondary icon-only-button" type="button" data-user-modal-close aria-label="Schließen">×</button>
                            </header>
                            <div class="user-modal-summary">
                              <span>Rolle: <strong><%= account.role %></strong></span>
                              <span>Projekt: <strong><%= account.currentProjectId || "-" %></strong></span>
                              <span>Aktualisiert: <strong><%= updatedLabel %></strong></span>
                            </div>
                            <form action="/einstellungen/benutzer/<%= account.id %>/rolle" method="post" class="user-modal-form">
                              <label>
                                <span>Rolle</span>
                                <select name="role" <%= account.id === user.id ? "disabled" : "" %>>
                                  <% (userRoles || []).forEach((role) => { %>
                                    <option value="<%= role %>" <%= role === account.role ? "selected" : "" %>><%= role %></option>
                                  <% }) %>
                                </select>
                              </label>
                              <button class="secondary compact-button" type="submit" <%= account.id === user.id ? "disabled" : "" %>>Rolle speichern</button>
                            </form>
                            <form action="/einstellungen/benutzer/<%= account.id %>/passwort" method="post" class="user-modal-form" data-confirm="Passwort für <%= account.email %> wirklich zurücksetzen? Bestehende Sessions werden beendet.">
                              <label>
                                <span>Neues Passwort</span>
                                <input type="password" name="password" placeholder="neues Passwort" autocomplete="new-password">
                              </label>
                              <button class="secondary compact-button" type="submit">Passwort setzen</button>
                            </form>
                            <footer class="user-modal-actions">
                              <form action="/einstellungen/benutzer/<%= account.id %>/status" method="post" data-confirm="<%= account.status === "disabled" ? "Benutzer wirklich aktivieren?" : "Benutzer wirklich sperren? Bestehende Sessions werden beendet." %>">
                                <input type="hidden" name="status" value="<%= account.status === "disabled" ? "active" : "disabled" %>">
                                <button class="secondary compact-button <%= account.status === "disabled" ? "" : "danger" %>" type="submit" <%= account.id === user.id ? "disabled" : "" %>>
                                  <%= account.status === "disabled" ? "Aktivieren" : "Sperren" %>
                                </button>
                              </form>
                              <button class="secondary compact-button" type="button" data-user-modal-close>Schließen</button>
                            </footer>
                          </section>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </section>
        <% } %>
      </section>

      <form id="leistungsbereiche-admin" action="/einstellungen/leistungsbereiche-formulare" method="post" data-autosave class="settings-panel" data-settings-panel="leistungsbereiche" hidden>
        <div class="panel-head">
          <div>
            <h2>Leistungsbereiche</h2>
            <p>Leistungsbereiche definieren und die zugehörigen generierten Formulare direkt im Bereich pflegen.</p>
          </div>
          <div class="panel-actions">
            <button class="secondary" type="button" data-add-leistungsbereich>Hinzufügen</button>
            <button class="secondary" type="submit" formaction="/einstellungen/leistungsbereiche/defaults" formmethod="post" data-no-autosave="true">Defaults wiederherstellen</button>
          </div>
        </div>

        <%# Globale Formularparameter werden erhalten; sichtbar gepflegt werden die Texte je Leistungsbereich. %>
        <div hidden>
          <% Object.entries(templates).forEach(([key, template]) => { %>
            <input type="hidden" name="templates[<%= key %>][titelPraefix]" value="<%= template.titelPraefix || "" %>">
            <input type="hidden" name="templates[<%= key %>][titelFallback]" value="<%= template.titelFallback || "" %>">
            <input type="hidden" name="templates[<%= key %>][titleAlign]" value="<%= template.titleAlign || "left" %>">
            <input type="hidden" name="templates[<%= key %>][fontSizeTitle]" value="<%= template.fontSizeTitle %>">
            <input type="hidden" name="templates[<%= key %>][fontSizeBody]" value="<%= template.fontSizeBody %>">
            <input type="hidden" name="templates[<%= key %>][margin]" value="<%= template.margin %>">
            <textarea name="templates[<%= key %>][bodyText]"><%= template.bodyText || "" %></textarea>
            <% if (template.normenFallback !== undefined) { %>
              <input type="hidden" name="templates[<%= key %>][normenFallback]" value="<%= template.normenFallback || "" %>">
            <% } %>
            <input type="hidden" name="templates[<%= key %>][signatureLabel]" value="<%= template.signatureLabel || "" %>">
            <% [
              "showProjectHeader",
              "showLeistungsbereich",
              "showNormen",
              "showSignature",
              "showFooter"
            ].forEach((field) => { %>
              <% if (template[field]) { %><input type="hidden" name="templates[<%= key %>][<%= field %>]" value="on"><% } %>
            <% }) %>
            <% Object.entries(template.textVarianten || {}).forEach(([variantKey, variant]) => { %>
              <% (variant.match || []).forEach((matchValue) => { %>
                <input type="hidden" name="templates[<%= key %>][textVarianten][<%= variantKey %>][match]" value="<%= matchValue %>">
              <% }) %>
              <input type="hidden" name="templates[<%= key %>][textVarianten][<%= variantKey %>][label]" value="<%= variant.label %>">
              <textarea name="templates[<%= key %>][textVarianten][<%= variantKey %>][text]"><%= variant.text || "" %></textarea>
            <% }) %>
          <% }) %>
        </div>

        <div class="leistungsbereich-config-list" data-leistungsbereiche-body>
          <% const templateTextForBereich = (template, bereich) => {
            const formConfig = template.leistungsbereichFormulare && template.leistungsbereichFormulare[bereich];
            const custom = formConfig && formConfig.text ? formConfig.text : template.leistungsbereichTexte && template.leistungsbereichTexte[bereich];
            if (custom) return custom;
            const variants = Object.values(template.textVarianten || {});
            const match = variants.find((variant) => (variant.match || []).includes(bereich));
            return (match && match.text) || (template.textVarianten && template.textVarianten.default && template.textVarianten.default.text) || template.bodyText || "";
          }; %>
          <% const templateEnabledForBereich = (template, bereich) => {
            const formConfig = template.leistungsbereichFormulare && template.leistungsbereichFormulare[bereich];
            return !formConfig || formConfig.erzeugen !== false;
          }; %>
          <div class="leistungsbereich-list-head" aria-hidden="true">
            <span>Leistungsbereich</span>
          </div>
          <% (leistungsbereiche.optionen || []).forEach((name, index) => { %>
            <% const isActiveBereich = (leistungsbereiche.aktiv || []).includes(name); %>
            <details class="leistungsbereich-list-row" data-leistungsbereich-card>
              <summary class="leistungsbereich-row-summary">
                <span class="leistungsbereich-summary-title">
                  <strong><%= name %></strong>
                  <small><%= isActiveBereich ? "aktiv" : "inaktiv" %></small>
                </span>
                <i aria-hidden="true"></i>
              </summary>
              <div class="leistungsbereich-config-body">
                <section class="leistungsbereich-config-section">
                  <div class="form-grid compact">
                    <label>
                      <span>Name</span>
                      <input type="text" data-leistungsbereich-name name="leistungsbereiche[<%= index %>][name]" value="<%= name %>">
                    </label>
                    <label class="switch-control">
                      <input type="checkbox" name="leistungsbereiche[<%= index %>][aktiv]" <%= isActiveBereich ? "checked" : "" %>>
                      <span class="switch-track" aria-hidden="true"></span>
                      <span>Aktiv</span>
                    </label>
                    <button class="row-delete-button danger icon-only-button" type="button" data-delete-row data-delete-label="Leistungsbereich <%= name %>" aria-label="Leistungsbereich löschen"><%- include("partials/icon", { name: "trash" }) %></button>
                  </div>
                </section>
                <section class="leistungsbereich-config-section">
                  <div class="edit-section-head">
                    <div>
                      <h2>Formulargenerator</h2>
                      <p>Texte für automatisch erzeugte Formulare dieses Leistungsbereichs.</p>
                    </div>
                  </div>
                  <div class="template-text-grid">
                    <% Object.entries(templates).forEach(([key, template]) => { %>
                      <article class="variant-text template-text-card">
                        <div class="template-text-card-head">
                          <span><%= template.name %></span>
                          <label class="switch-control">
                            <input type="hidden" name="templates[<%= key %>][leistungsbereichFormulare][<%= index %>][erzeugen]" value="false">
                            <input type="checkbox" name="templates[<%= key %>][leistungsbereichFormulare][<%= index %>][erzeugen]" <%= templateEnabledForBereich(template, name) ? "checked" : "" %>>
                            <span class="switch-track" aria-hidden="true"></span>
                            <span>erzeugen</span>
                          </label>
                        </div>
                        <input type="hidden" data-template-leistungsbereich-name name="templates[<%= key %>][leistungsbereichFormulare][<%= index %>][leistungsbereich]" value="<%= name %>">
                        <textarea name="templates[<%= key %>][leistungsbereichFormulare][<%= index %>][text]" rows="4"><%= templateTextForBereich(template, name) %></textarea>
                      </article>
                    <% }) %>
                  </div>
                </section>
              </div>
            </details>
          <% }) %>
        </div>
      </form>

      <form id="geraetelisten-vorlagen" action="/einstellungen/geraetelisten-vorlagen" method="post" data-autosave class="settings-panel" data-settings-panel="geraetelisten-vorlagen" hidden>
        <div class="panel-head">
          <div>
            <h2>Gerätelisten-Vorlagen</h2>
            <p>Systemweite Vorlagen verwalten, die im Drei-Punkte-Menü der Gerätelisten geladen werden können.</p>
          </div>
        </div>

        <% if (!(geraetelistenVorlagen || []).length) { %>
          <p class="notice subtle">Noch keine Vorlagen gespeichert. Speichere eine Geräteliste über Gerätelisten &gt; Werkzeuge &gt; Als Vorlage speichern.</p>
        <% } else { %>
          <div class="table-wrap template-admin-table">
            <table>
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Leistungsbereich</th>
                  <th>Kapitel</th>
                  <th>Positionen</th>
                  <th>Aktualisiert</th>
                  <th>Entfernen</th>
                </tr>
              </thead>
              <tbody>
                <% (geraetelistenVorlagen || []).forEach((vorlage, index) => { %>
                  <tr>
                    <td>
                      <input type="hidden" name="vorlagen[<%= index %>][id]" value="<%= vorlage.id %>">
                      <input type="text" name="vorlagen[<%= index %>][name]" value="<%= vorlage.name %>">
                    </td>
                    <td><%= vorlage.leistungsbereich %></td>
                    <td><%= vorlage.kapitel %></td>
                    <td><%= vorlage.positionen.length %></td>
                    <td><%= vorlage.aktualisiertAm ? new Date(vorlage.aktualisiertAm).toLocaleString("de-DE") : "-" %></td>
                    <td>
                      <button class="row-delete-button danger icon-only-button" type="button" data-delete-row data-delete-label="Vorlage <%= vorlage.name %>" aria-label="Gerätelisten-Vorlage löschen"><%- include("partials/icon", { name: "trash" }) %></button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </form>

    </main>
    <%- include("partials/footer") %>
    <script type="application/json" id="form-template-names-json"><%- JSON.stringify(Object.fromEntries(Object.entries(templates || {}).map(([key, template]) => [key, template.name]))) %></script>
    <script type="application/json" id="theme-presets-json"><%- JSON.stringify(themePresets || {}) %></script>
    <script src="/js/app.js"></script>
  </body>
</html>
