<!doctype html>
<html lang="de">
  <head>
    <%- include("partials/head", { pageTitle: "Anmelden" }) %>
  </head>
  <body>
    <%# Öffentliche Login-Seite. Authentifizierung wird serverseitig in authService geprüft. %>
    <%- include("partials/themeVariables") %>
    <main id="main-content" tabindex="-1" class="auth-page">
      <%- include("partials/authIntro") %>
      <section class="auth-card">
        <div class="auth-brand">
          <img class="auth-logo" src="/img/icons/edoku-app-icon.svg?v=2" alt="" width="48" height="48">
          <div>
            <p class="eyebrow">edoku</p>
            <h1>Anmelden</h1>
          </div>
        </div>
        <p class="auth-subtitle">Melde dich an, um an deinen Projekten weiterzuarbeiten.</p>
        <%- include("partials/flash", { flash }) %>
        <form action="/login" method="post" class="stack-form">
          <label>
            <span>E-Mail oder Benutzername</span>
            <input type="text" name="email" autocomplete="username" required>
          </label>
          <label>
            <span>Passwort</span>
            <input type="password" name="password" autocomplete="current-password" required>
          </label>
          <button type="submit">Anmelden</button>
        </form>
        <p class="meta-line">Noch kein Konto? <a href="/register">Registrieren</a></p>
      </section>
    </main>
    <%- include("partials/footer") %>
    <script src="/js/app.js"></script>
  </body>
</html>
