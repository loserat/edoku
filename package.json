{
  "name": "edoku",
  "version": "0.1.0-beta.1",
  "description": "Lokale Web-Anwendung fuer einen Elektro-Dokumentationsmanager.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "smoke:api": "node scripts/smoke-api.js",
    "test:exports": "node --test scripts/export-counting.test.js",
    "test:preservation": "node --test scripts/update-preservation.test.js",
    "test:security": "node --test scripts/security-archive.test.js",
    "test:audit": "node --test scripts/audit.test.js",
    "test:backup": "python3 -m unittest discover -s scripts -p test_installation_backup.py",
    "test:e2e": "node --test scripts/local-beta.e2e.test.js",
    "check": "node scripts/check-source.js",
    "test": "node --test scripts/export-counting.test.js scripts/update-preservation.test.js scripts/security-archive.test.js scripts/audit.test.js scripts/local-beta.e2e.test.js && npm run test:backup",
    "backup": "python3 scripts/installation_backup.py"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.15.0"
  },
  "engines": {
    "node": ">=20"
  }
}
